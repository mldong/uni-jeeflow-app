/**
 * 表单 schema 注册表 —— m-schema-form 的数据源
 *
 * 背景：web 端发起/任务表单是「命名 Vue 组件」（jsonObject.instanceUrl / task.formKey →
 * wfFormComponentMap），移动端无法复用，故改为 schema JSON 驱动渲染（m-schema-form）。
 * key = instanceUrl / formKey（小写匹配），未注册的 key 由调用方降级为只读键值列表。
 *
 * 字段类型：input | number | textarea | date | select | radio | checkbox | upload
 * 字段 id 契约（pro 实测 2026-08-30）：
 *   - 命名组件（LeaveWfForm）：表单 id 已带 f_（f_reasonType / f_day / f_title），提交原样保留
 *   - SchemaWfForm / __schema__：pro 种子 fieldName 已是 f_sealType（非 sealType）；
 *     若再 toCamelCase 会变成 fSealType，提交再加 f_ → f_fSealType（pro 站自身双前缀缺陷）。
 *     App 策略：fieldName 已含 f_/tf_ 则原样作表单 id；否则 toCamelCase 后提交再加 f_
 */
export type SchemaField = {
	field: string; // 表单字段 id（动态=camelCase；命名组件可含 f_）
	label: string;
	type: string; // input|number|textarea|date|select|radio|checkbox|upload
	required: boolean;
	placeholder: string;
	options: UTSJSONObject[]; // select/radio/checkbox 静态选项 {label,value}
	dictType: string; // 远程字典编码（/sys/dict/getByDictType），非空时优先于 options
	readonly: boolean;
}

/** 流程表单变量前缀（对齐 vben PROCESS_FORM_FIELD_PREFIX） */
export const PROCESS_FORM_FIELD_PREFIX = 'f_'

/**
 * snake_case → camelCase（对齐 vben util/tool.toCamelCase）
 * leave_type → leaveType；已是 camel 则原样返回。
 * 注意：勿对已带 f_ 的名调用（f_sealType → fSealType 会翻车）。
 */
export const toCamelCase = (str: string): string => {
	if (str.length == 0) {
		return str
	}
	let result = ''
	let upperNext = false
	for (let i = 0; i < str.length; i++) {
		const c = str.charAt(i)
		if (c == '_') {
			upperNext = true
			continue
		}
		if (upperNext) {
			result += c.toUpperCase()
			upperNext = false
		} else {
			result += c
		}
	}
	return result
}

/**
 * 解析动态表单字段 id（schemaFromColumns 唯一入口）。
 * fieldCamelName 优先；fieldName 已是 f_/tf_ 前缀则原样保留；否则 toCamelCase。
 */
export const resolveSchemaFieldId = (fieldName: string, fieldCamelName: string): string => {
	if (fieldCamelName.length > 0) {
		return fieldCamelName
	}
	if (fieldName.startsWith(PROCESS_FORM_FIELD_PREFIX) || fieldName.startsWith('tf_')) {
		return fieldName
	}
	return toCamelCase(fieldName)
}

/**
 * 提交前：非 f_/tf_ 键统一加 f_（对齐 start-process / task-form）
 */
export const withProcessFormPrefix = (formData: UTSJSONObject): UTSJSONObject => {
	const out = {} as UTSJSONObject
	formData.toMap().forEach((value, key) => {
		if (key.startsWith(PROCESS_FORM_FIELD_PREFIX) || key.startsWith('tf_')) {
			out[key] = value
		} else {
			out[PROCESS_FORM_FIELD_PREFIX + key] = value
		}
	})
	return out
}

/**
 * 回显：schema 字段为 camelCase 时，若 formData 仅有 f_camel，则写入无前缀键供 m-schema-form 读取。
 * 命名组件字段已带 f_ 时跳过（直接读引擎键）。
 */
export const hydrateSchemaFormData = (formData: UTSJSONObject, fields: SchemaField[]): void => {
	for (let i = 0; i < fields.length; i++) {
		const f = fields[i].field
		if (f.startsWith(PROCESS_FORM_FIELD_PREFIX) || f.startsWith('tf_')) {
			continue
		}
		if (formData.get(f) != null) {
			continue
		}
		const v = formData.get(PROCESS_FORM_FIELD_PREFIX + f)
		if (v != null) {
			formData[f] = v
		}
	}
}

export type FormSchema = {
	key: string; // instanceUrl / formKey（小写）
	title: string;
	fields: SchemaField[];
}

const opt = (label: string, value: string): UTSJSONObject => {
	return { label: label, value: value } as UTSJSONObject
}

