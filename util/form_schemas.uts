/**
 * 表单 schema 注册表 —— m-schema-form 的数据源
 *
 * 背景：web 端发起/任务表单是「命名 Vue 组件」（jsonObject.instanceUrl / task.formKey →
 * wfFormComponentMap），移动端无法复用，故改为 schema JSON 驱动渲染（m-schema-form）。
 * key = instanceUrl / formKey（小写匹配），未注册的 key 由调用方降级为只读键值列表。
 *
 * 字段类型：input | number | textarea | date | select | radio | checkbox | upload
 * 多选：SchemaField.multiple=true 时 select 渲染为 checkbox-group，值存逗号串
 *（引擎 tf_nextNodeOperator/f_ccActors 等对数组/逗号串双兼容，见 jeeflow-java CreateTaskHandler）。
 * 字段 id 契约（pro 实测 2026-08-30）：
 *   - 命名组件（LeaveWfForm）：表单 id 已带 f_（f_reasonType / f_day / f_title），提交原样保留
 *   - SchemaWfForm / __schema__：pro 种子 fieldName 已是 f_sealType（非 sealType）；
 *     若再 toCamelCase 会变成 fSealType，提交再加 f_ → f_fSealType（pro 站自身双前缀缺陷）。
 *     App 策略：fieldName 已含 f_/tf_ 则原样作表单 id；否则 toCamelCase 后提交再加 f_
 */
export type SchemaField = {
	field: string; // 表单字段 id（动态=camelCase；命名组件可含 f_）
	label: string;
	type: string; // input|number|textarea|date|select|radio|checkbox|upload
	required: boolean;
	placeholder: string;
	options: UTSJSONObject[]; // select/radio/checkbox 静态选项 {label,value}
	dictType: string; // 远程字典编码（/sys/dict/getByDictType），非空时优先于 options
	// ApiSelect/ApiTreeSelect 远程选项接口（如部门树 /sys/dept/tree），非空时优先于 dictType
	apiOptions: string;
	// 远程选项的 label/value 键（部门树 name/id；用户下拉 label/value），拍平时用
	apiLabelField: string;
	apiValueField: string;
	readonly: boolean;
	// 多选（vben ext {Component}_mode=='multiple' / {Component}_multiple）；select 渲染 checkbox-group，值逗号串
	multiple: boolean;
	// 字段权限 HIDDEN（vben enableFieldPerm → taskModel.ext PERMISSION_<fieldId>==3），渲染层直接过滤
	hidden: boolean;
	// 列默认值原始串 + 列 dataType（'12' 数值 / '30' JSON），applyFieldDefaults 灌入 formData（对齐 vben）
	defaultValue: string;
	defaultValueType: string;
}

/** 流程表单变量前缀（对齐 vben PROCESS_FORM_FIELD_PREFIX） */
export const PROCESS_FORM_FIELD_PREFIX = 'f_'

/**
 * snake_case → camelCase（对齐 vben util/tool.toCamelCase）
 * leave_type → leaveType；已是 camel 则原样返回。
 * 注意：勿对已带 f_ 的名调用（f_sealType → fSealType 会翻车）。
 */
export const toCamelCase = (str: string): string => {
	if (str.length == 0) {
		return str
	}
	let result = ''
	let upperNext = false
	for (let i = 0; i < str.length; i++) {
		const c = str.charAt(i)
		if (c == '_') {
			upperNext = true
			continue
		}
		if (upperNext) {
			result += c.toUpperCase()
			upperNext = false
		} else {
			result += c
		}
	}
	return result
}

/**
 * ApiSelect/ApiTreeSelect 远程选项拍平：行数组 / 嵌套树（children）/ 内嵌 options 数组
 * 统一转成 [{label, value}]（value 字符串化，雪花 id 保精度；labelField/valueField 可配，默认 name/id）。
 * 数据形态兼容：行数组（/sys/user/select）、部门树（/sys/dept/tree）、{rows:[...]}、{list:[...]}、{options:[...]}。
 * 父节点自身也入选项（部门树父级如"广西公司"亦是合法目标部门）。
 * 入参 any 规避 UTS getArray CapturedType 与 UTSArray 形参不匹配（同 schemaFromColumns）。
 */
export const flattenApiOptions = (data: any, labelField: string, valueField: string): UTSJSONObject[] => {
	const out: UTSJSONObject[] = []
	const labelKey = labelField.length > 0 ? labelField : 'name'
	const valueKey = valueField.length > 0 ? valueField : 'id'
	// 顶层节点收集（行数组 / {rows|list|options} 包装）进栈
	const stack: UTSJSONObject[] = []
	const top = data as UTSJSONObject[] | null
	if (top != null) {
		for (let i = 0; i < top!.length; i++) {
			stack.push(top![i])
		}
	} else {
		const obj = data as UTSJSONObject | null
		if (obj != null) {
			const wrapKeys = ['rows', 'list', 'options'] as string[]
			for (let i = 0; i < wrapKeys.length; i++) {
				const arr = obj!.getArray<UTSJSONObject>(wrapKeys[i])
				if (arr != null) {
					for (let j = 0; j < arr!.length; j++) {
						stack.push(arr![j])
					}
					break
				}
			}
		}
	}
	// 迭代拍平（正向索引出栈，children 追加尾部；不用递归——UTS 自引用箭头函数不支持，error18）
	let i = 0
	while (i < stack.length) {
		const node = stack[i]
		i++
		const v = node.get(valueKey)
		if (v != null) {
			const l = node.get(labelKey)
			out.push({ label: l != null ? l.toString() : v.toString(), value: v.toString() } as UTSJSONObject)
		}
		const children = node.getArray<UTSJSONObject>('children')
		if (children != null) {
			for (let j = 0; j < children!.length; j++) {
				stack.push(children![j])
			}
		}
	}
	return out
}

/**
 * 解析动态表单字段 id（schemaFromColumns 唯一入口）。
 * fieldCamelName 优先；fieldName 已是 f_/tf_ 前缀则原样保留；否则 toCamelCase。
 */
export const resolveSchemaFieldId = (fieldName: string, fieldCamelName: string): string => {
	if (fieldCamelName.length > 0) {
		return fieldCamelName
	}
	if (fieldName.startsWith(PROCESS_FORM_FIELD_PREFIX) || fieldName.startsWith('tf_')) {
		return fieldName
	}
	return toCamelCase(fieldName)
}

/**
 * 提交前：非 f_/tf_ 键统一加 f_（对齐 start-process / task-form）
 */
export const withProcessFormPrefix = (formData: UTSJSONObject): UTSJSONObject => {
	const out = {} as UTSJSONObject
	formData.toMap().forEach((value, key) => {
		if (key.startsWith(PROCESS_FORM_FIELD_PREFIX) || key.startsWith('tf_')) {
			out[key] = value
		} else {
			out[PROCESS_FORM_FIELD_PREFIX + key] = value
		}
	})
	return out
}

/**
 * 回显：schema 字段为 camelCase 时，若 formData 仅有 f_camel，则写入无前缀键供 m-schema-form 读取。
 * 命名组件字段已带 f_ 时跳过（直接读引擎键）。
 */
export const hydrateSchemaFormData = (formData: UTSJSONObject, fields: SchemaField[]): void => {
	for (let i = 0; i < fields.length; i++) {
		const f = fields[i].field
		if (f.startsWith(PROCESS_FORM_FIELD_PREFIX) || f.startsWith('tf_')) {
			continue
		}
		if (formData.get(f) != null) {
			continue
		}
		const v = formData.get(PROCESS_FORM_FIELD_PREFIX + f)
		if (v != null) {
			formData[f] = v
		}
	}
}

/**
 * 列默认值灌入（对齐 vben buildFormFieldSchema：dataType 12→数值 / 30→JSON.parse，其余原样字符串）。
 * 仅 formData 无该键时写入；调用时机 = 表单初始化后、重新发起 prefill 前（prefill 覆盖默认值）。
 */
export const applyFieldDefaults = (formData: UTSJSONObject, fields: SchemaField[]): void => {
	for (let i = 0; i < fields.length; i++) {
		const f = fields[i]
		if (f.defaultValue.length == 0 || formData.get(f.field) != null) {
			continue
		}
		if (f.defaultValueType == '12') {
			const n = parseFloat(f.defaultValue)
			if (!isNaN(n)) {
				formData[f.field] = n
			}
		} else if (f.defaultValueType == '30') {
			const parsed = JSON.parse(f.defaultValue)
			if (parsed != null) {
				formData[f.field] = parsed!
			}
		} else {
			formData[f.field] = f.defaultValue
		}
	}
}

/**
 * 流程级「发起附加字段」构建（对齐 vben select-user-form-ignore.vue 四开关）：
 * selectUserOnInitiate → f_nextNodeOperator（多选，selectUserApi || /sys/user/select，必填）
 * enableCcActors      → f_ccActors（多选，/sys/user/select）
 * enableApplyReason   → f_applyReason（textarea）
 * enableAttachment    → f_attachment（upload）
 * 已存在同名字段时跳过（如 leave 命名表单自带 f_attachment）。
 */
export const buildInitiatorExtraFields = (jsonObject: UTSJSONObject | null, existing: SchemaField[]): SchemaField[] => {
	const out: SchemaField[] = []
	if (jsonObject == null) {
		return out
	}
	const jo = jsonObject!
	const hasField = (id: string): boolean => {
		for (let i = 0; i < existing.length; i++) {
			if (existing[i].field == id) {
				return true
			}
		}
		for (let i = 0; i < out.length; i++) {
			if (out[i].field == id) {
				return true
			}
		}
		return false
	}
	const flagOn = (key: string): boolean => {
		if (jo.getBoolean(key) == true) {
			return true
		}
		const n = jo.getNumber(key)
		return n != null && n == 1
	}
	if (flagOn('selectUserOnInitiate') && !hasField('f_nextNodeOperator')) {
		let api = jo.getString('selectUserApi') ?? ''
		let lf = 'name'
		if (api.length == 0) {
			api = '/sys/user/select'
		}
		if (api == '/sys/user/select') {
			lf = 'realName'
		}
		out.push({
			field: 'f_nextNodeOperator',
			label: '指定下一节点处理人',
			type: 'select',
			required: true,
			placeholder: '请选择下一节点处理人',
			options: [] as UTSJSONObject[],
			dictType: '',
			apiOptions: api,
			apiLabelField: lf,
			apiValueField: 'id',
			readonly: false,
			multiple: true,
			hidden: false,
			defaultValue: '',
			defaultValueType: ''
		} as SchemaField)
	}
	if (flagOn('enableCcActors') && !hasField('f_ccActors')) {
		out.push({
			field: 'f_ccActors',
			label: '抄送给',
			type: 'select',
			required: false,
			placeholder: '请选择抄送给',
			options: [] as UTSJSONObject[],
			dictType: '',
			apiOptions: '/sys/user/select',
			apiLabelField: 'realName',
			apiValueField: 'id',
			readonly: false,
			multiple: true,
			hidden: false,
			defaultValue: '',
			defaultValueType: ''
		} as SchemaField)
	}
	if (flagOn('enableApplyReason') && !hasField('f_applyReason')) {
		out.push({
			field: 'f_applyReason',
			label: '申请理由',
			type: 'textarea',
			required: false,
			placeholder: '请输入申请理由',
			options: [] as UTSJSONObject[],
			dictType: '',
			apiOptions: '',
			apiLabelField: '',
			apiValueField: '',
			readonly: false,
			multiple: false,
			hidden: false,
			defaultValue: '',
			defaultValueType: ''
		} as SchemaField)
	}
	if (flagOn('enableAttachment') && !hasField('f_attachment')) {
		out.push({
			field: 'f_attachment',
			label: '上传附件',
			type: 'upload',
			required: false,
			placeholder: '可选',
			options: [] as UTSJSONObject[],
			dictType: '',
			apiOptions: '',
			apiLabelField: '',
			apiValueField: '',
			readonly: false,
			multiple: false,
			hidden: false,
			defaultValue: '',
			defaultValueType: ''
		} as SchemaField)
	}
	return out
}

/**
 * 节点字段权限（对齐 vben process-task/detail.vue initPermission）：
 * enableFieldPerm 开启时读 taskModel.ext 的 PERMISSION_<fieldId>：
 * 1=只读（readonly）3=隐藏（hidden），缺省 2=可编辑。fieldId 与 vben 表单 schema fieldName 同源
 * （动态=camelCase 无前缀；命名组件=f_ 前缀原样），两端键天然一致。
 */
export const applyFieldPermissions = (fields: SchemaField[], taskModelExt: UTSJSONObject | null): void => {
	if (taskModelExt == null) {
		return
	}
	for (let i = 0; i < fields.length; i++) {
		const perm = taskModelExt!.getNumber('PERMISSION_' + fields[i].field)
		if (perm == 1) {
			fields[i].readonly = true
		} else if (perm == 3) {
			fields[i].hidden = true
		}
	}
}

export type FormSchema = {
	key: string; // instanceUrl / formKey（小写）
	title: string;
	fields: SchemaField[];
}

const opt = (label: string, value: string): UTSJSONObject => {
	return { label: label, value: value } as UTSJSONObject
}

