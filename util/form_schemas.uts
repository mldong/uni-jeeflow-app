// ── 命名注册表：只挂 instanceUrl（对齐 vben wfFormComponentMap / defineOptions.name）──
// SchemaWfForm 不注册；走 __schema__ → getByTableName(processDefine.name)。
// 禁止 defineName（biz_leave / seal_apply…）旁路。
const schemaRegistry: FormSchema[] = [
	leaveSchema
]

const getSchemaByKey = (key: string): FormSchema | null => {
	if (key.length == 0) {
		return null
	}
	const k = key.toLowerCase()
	for (let i = 0; i < schemaRegistry.length; i++) {
		if (schemaRegistry[i].key == k) {
			return schemaRegistry[i]
		}
	}
	return null
}

/** 是否元数据表单（对齐 vben SchemaWfForm） */
export const isSchemaWfForm = (instanceUrl: string): boolean => {
	return instanceUrl.toLowerCase() == 'schemawfform'
}

/**
 * 只按 instanceUrl 查命名表单（对齐 vben wfFormComponentMap.get(instanceUrl)）。
 * SchemaWfForm / 空 / 未注册 → null；调用方明确失败，禁止 defineName 偷换。
 */
export const resolveFormSchema = (instanceUrl: string): FormSchema | null => {
	if (instanceUrl.length == 0 || isSchemaWfForm(instanceUrl)) {
		return null
	}
	return getSchemaByKey(instanceUrl)
}

/**
 * 发起场景是否应跳过该列（主键/雪花 id 等不应出现在申请表单）。
 * 旁路库 getByTableName 常有 id 列：remark=主键(雪花)、primary=1、listHide=1，但无 addHide。
 */
const shouldSkipInitiateColumn = (col: UTSJSONObject, fieldName: string, ext: UTSJSONObject | null): boolean => {
	if (ext != null && ext!.getNumber('addHide') == 1) {
		return true
	}
	if (fieldName.toLowerCase() == 'id') {
		return true
	}
	const primary = col.getNumber('primary') ?? col.getNumber('isPk')
	if (primary != null && primary == 1) {
		return true
	}
	if (ext != null) {
		const extPk = ext!.getNumber('primary') ?? ext!.getNumber('isPk')
		if (extPk != null && extPk == 1) {
			return true
		}
	}
	const remark = col.getString('remark') ?? ''
	if (remark.indexOf('主键') >= 0) {
		return true
	}
	return false
}

/**
 * 列数组 → SchemaField[]（__schema__.columns 或 getByTableName.data.columns）
 * 跳过 addHide=1 / 主键(id|primary|remark含「主键」)；未知组件降级 input（不静默丢列）。
 * 字段 id = resolveSchemaFieldId（已含 f_/tf_ 则原样，否则 camelCase；提交 withProcessFormPrefix）。
 * 入参用 any 规避 UTS getArray CapturedType 与 UTSArray 形参不匹配（error17）。
 */
export const schemaFromColumns = (columns: any): SchemaField[] | null => {
	if (columns == null) {
		return null
	}
	const list = columns as Array<UTSJSONObject>
	if (list.length == 0) {
		return null
	}
	const fields: SchemaField[] = []
	for (let i = 0; i < list.length; i++) {
		const col = list[i]
		const fieldName = col.getString('fieldName') ?? ''
		if (fieldName.length == 0) {
			continue
		}
		const ext = col.getJSON('ext')
		if (shouldSkipInitiateColumn(col, fieldName, ext)) {
			continue
		}
		const camel = col.getString('fieldCamelName') ?? ''
		const fieldId = resolveSchemaFieldId(fieldName, camel)
		const component = col.getString('component') ?? 'Input'
		let type = ''
		let dictType = ''
		let readonly = false
		// 对齐 vben buildFormFieldSchema / toComponentProps 常用组件
		if (component == 'Input' || component == 'InputPassword' || component == 'AutoComplete'
			|| component == 'StrengthMeter' || component == 'InputCountDown' || component == 'IconPicker'
			|| component == 'Mentions') {
			type = 'input'
		} else if (component == 'Textarea' || component == 'InputTextArea' || component == 'RichText'
			|| component == 'RichTextEditor' || component == 'Editor' || component == 'Tinymce') {
			type = 'textarea'
		} else if (component == 'InputNumber' || component == 'Rate' || component == 'Slider') {
			type = 'number'
		} else if (component == 'DatePicker' || component == 'TimePicker' || component == 'RangePicker'
			|| component == 'MonthPicker' || component == 'WeekPicker') {
			type = 'date'
		} else if (component == 'ApiDict') {
			type = 'select'
			if (ext != null) {
				dictType = ext!.getString('ApiDict_code') ?? ext!.getString('code') ?? ''
			}
		} else if (component == 'Select' || component == 'ApiSelect' || component == 'ApiTreeSelect'
			|| component == 'ApiCascader' || component == 'ApiSelectTable' || component == 'TreeSelect'
			|| component == 'Cascader' || component == 'Transfer' || component == 'ApiTransfer') {
			type = 'select'
			if (ext != null) {
				dictType = ext!.getString(component + '_code') ?? ext!.getString('code') ?? ''
			}
		} else if (component == 'RadioGroup' || component == 'Radio' || component == 'ApiRadioGroup') {
			type = 'radio'
		} else if (component == 'CheckboxGroup' || component == 'Checkbox') {
			type = 'checkbox'
		} else if (component == 'Switch') {
			// 移动端无 Switch：降级为 select（是/否）
			type = 'select'
		} else if (component == 'Upload' || component == 'ImageUpload' || component == 'FileUpload') {
			type = 'upload'
		} else {
			// 未知组件：降级 input，保留列（禁止静默丢字段）
			type = 'input'
			readonly = true
		}
		let required = false
		if (ext != null && ext!.getNumber('required') == 1) {
			required = true
		}
		// pro __schema__ 偶发只写 rules:'required'、ext.required 缺失
		const rules = col.getString('rules') ?? ''
		if (!required && rules.indexOf('required') >= 0) {
			required = true
		}
		const label = col.getString('remark') ?? (col.getString('label') ?? fieldName)
		let options: UTSJSONObject[] = [] as UTSJSONObject[]
		if (component == 'Switch') {
			options = [opt('是', '1'), opt('否', '0')] as UTSJSONObject[]
		}
		fields.push({
			field: fieldId,
			label: label,
			type: type,
			required: required,
			placeholder: (type == 'select' || type == 'date' ? '请选择' : '请输入') + label,
			options: options,
			dictType: dictType,
			readonly: readonly
		} as SchemaField)
	}
	if (fields.length == 0) {
		return null
	}
	return fields
}

/**
 * 低代码 __schema__ 列定义 → SchemaField[]（pro 站 SchemaWfForm 内嵌路径）
 */
export const schemaFromGraph = (graph: UTSJSONObject): SchemaField[] | null => {
	const sc = graph.getJSON('__schema__')
	if (sc == null) {
		return null
	}
	return schemaFromColumns(sc!.getArray('columns') as any)
}

/** getByTableName 响应 data → SchemaField[] */
export const schemaFromTableModel = (model: UTSJSONObject): SchemaField[] | null => {
	return schemaFromColumns(model.getArray('columns') as any)
}

/**
 * 请假天数自动计算（对齐 vben leave-wf-form 的 trigger 逻辑）
 * 返回 -1 表示起止不完整
 */
export const calcLeaveDays = (formData: UTSJSONObject): number => {
	const startTime = formData.getString('f_startTime') ?? ''
	const endTime = formData.getString('f_endTime') ?? ''
	const startPeriod = formData.getString('f_startPeriod') ?? ''
	const endPeriod = formData.getString('f_endPeriod') ?? ''
	if (startTime.length == 0 || endTime.length == 0 || startPeriod.length == 0 || endPeriod.length == 0) {
		return -1
	}
	const startTs = Date.parse(startTime + 'T00:00:00')
	const endTs = Date.parse(endTime + 'T00:00:00')
	if (isNaN(startTs) || isNaN(endTs)) {
		return -1
	}
	const diffDays = (endTs - startTs) / 86400000.0
	let total = 0.0
	if (diffDays == 0.0) {
		if (startPeriod == 'AM' && endPeriod == 'AM') {
			total = 0.5
		} else if (startPeriod == 'AM' && endPeriod == 'PM') {
			total = 1.0
		} else if (startPeriod == 'PM' && endPeriod == 'PM') {
			total = 0.5
		} else {
			return -1
		}
	} else if (diffDays < 0) {
		return -1
	} else {
		total = diffDays + 1
		if (startPeriod == 'PM') {
			total -= 0.5
		}
		if (endPeriod == 'AM') {
			total -= 0.5
		}
	}
	return Math.round(total * 100) / 100.0
}
