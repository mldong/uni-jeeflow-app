<template>
	<view class="m-main">
		<!-- 开发环境长按 logo 弹接口切换（模拟器/adb 走查用，真机可摇一摇）；正式包无任何入口 -->
		<view class="m-logo" @longpress="onLogoLongpress">
			<image class="m-logo-img" src="/static/app-icons/logo.png" mode="aspectFit"></image>
			<text class="m-logo-title">jeeflow 审批</text>
			<text class="m-logo-sub">jeeflow 工作流系列管理系统</text>
		</view>
		<view class="m-content">
			<form class="m-form">
				<view class="uni-form-item">
					<view class="uni-label">
						<m-icon type="person-filled" :size="30"></m-icon>
					</view>
					<input class="uni-input" name="userName" v-model="userName" placeholder="请输入用户名"/>
				</view>
				<view class="uni-form-item">
					<view class="uni-label">
						<m-icon type="locked-filled" :size="30"></m-icon>
					</view>
					<input class="uni-input" :password="true" name="password" v-model="password" placeholder="请输入密码"/>
				</view>
				<view class="uni-form-item" v-if="captchaFlag">
					<view class="uni-label">
						<m-icon type="checkmarkempty" :size="30"></m-icon>
					</view>
					<input class="uni-input" name="captcha" v-model="captchaCode" placeholder="请输入验证码"/>
					<image class="m-captcha" mode="aspectFit" :src="captchaImg" @tap="loadCaptcha"></image>
				</view>
				<view class="uni-btn-v flex-row">
					<button class="btn btn-submit" form-type="submit" type="primary" @tap="handleLogin">登录</button>
				</view>
			</form>
		</view>
	</view>
</template>
<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	import { login, getCaptchaOpenFlag, captcha } from '@/api/user.uts'
	import { TOKEY_KEY, IS_LOGIN_KEY } from '@/util/const'
	import { cleanCache, setRefreshToken } from '@/util/cache_util.uts';
	import { showApiSwitchSheet } from '@/util/api_switch.uts'
	import { $store } from '@/store/index'
	import { $strUtil } from '@/util/str_util'
	import { responseInterceptor } from '@/util/http.uts'

	const userName = ref('admin')
	const password = ref('123456')
	const captchaFlag = ref(false)
	const captchaImg = ref('')
	const captchaUuid = ref('')
	const captchaCode = ref('')

	// 开发环境长按 logo 弹接口切换（IS_DEV 在 util 内短路，正式包无此能力）
	function onLogoLongpress() {
		showApiSwitchSheet()
	}

	async function handleLogin() {
		if ($strUtil.isEmpty(userName.value) || $strUtil.isEmpty(password.value)) {
			uni.showToast({
				title: '用户名或密码不能为空'
			})
			return;
		}
		if (captchaFlag.value && $strUtil.isEmpty(captchaCode.value)) {
			uni.showToast({
				title: '请输入验证码'
			})
			return;
		}
		uni.showLoading({
			title: "登录中……",
			mask: true
		})
		try {
			const param = {
				userName: userName.value,
				password: password.value
			} as UTSJSONObject
			if (captchaFlag.value) {
				param['code'] = captchaCode.value
				param['uuid'] = captchaUuid.value
			}
			const res = await login(param)
			if (responseInterceptor(res)) {
				const data = res as UTSJSONObject
				const token = data.getString("token")
				uni.setStorageSync(TOKEY_KEY, $strUtil.toStr(token))
				// UC-0113：refreshToken 与 access 同对保存，access 失效时静默续命用
				setRefreshToken(data.getString("refreshToken"))
				uni.setStorageSync(IS_LOGIN_KEY, true)
				$store.setIsLogin(true)
				uni.reLaunch({
					url: '/pages/index/index'
				})
			}
		} catch (err) {
			uni.showToast({
				title: $strUtil.anyToStr(err),
				icon: 'none'
			})
		} finally {
			uni.hideLoading()
		}
	}

	function loadCaptcha() {
		captcha().then((res) => {
			const data = res as UTSJSONObject
			captchaUuid.value = data.getString('uuid') ?? ''
			const b64 = data.getString('base64') ?? ''
			captchaImg.value = b64.startsWith('data:') ? b64 : 'data:image/png;base64,' + b64
		}).catch(() => {
			uni.showToast({
				title: '验证码加载失败',
				icon: 'none'
			})
		})
	}

	function initCaptcha() {
		getCaptchaOpenFlag().then((res) => {
			const flag = (res as UTSJSONObject).getBoolean('flag')
			captchaFlag.value = flag == true
			if (captchaFlag.value) {
				loadCaptcha()
			}
		}).catch(() => {
			// 开关接口异常按关闭处理
			captchaFlag.value = false
		})
	}

	onLoad(() => {
		cleanCache()
		$store.resetAuth()
		initCaptcha()
	})
</script>

<style lang="less">
	.m-main {
		flex: 1;
		justify-content: flex-start;
		align-items: center;
		background-color: #F5F6FA;
	}

	.m-logo {
		margin-top: 160rpx;
		align-items: center;
	}

	.m-logo-img {
		width: 160rpx;
		height: 160rpx;
		margin-bottom: 28rpx;
		border-radius: 32rpx;
	}

	.m-logo-title {
		font-size: 48rpx;
		font-weight: bold;
		color: #2563EB;
	}

	.m-logo-sub {
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #999999;
	}

	.m-content {
		margin-top: 100rpx;
	}

	.m-form {
		width: 600rpx;
	}

	.uni-form-item {
		flex-direction: row;
		align-items: center;
		height: 100rpx;
		background-color: #ffffff;
		border-radius: 12rpx;
		margin-bottom: 24rpx;
	}

	.uni-label {
		padding-left: 30rpx;
	}

	.uni-input {
		flex: 1;
		height: 100rpx;
		font-size: 28rpx;
		padding-left: 10rpx;
	}

	.m-captcha {
		width: 180rpx;
		height: 60rpx;
		margin: 20rpx;
	}

	.btn-submit {
		margin-top: 48rpx;
		background-color: #2563EB;
		border-radius: 12rpx;
	}
</style>
