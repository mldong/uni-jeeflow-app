<template>
	<view style="flex: 1;background-color: #F5F6FA;">
		<m-navigation-bar :showBack="true">
			<template #title>
				<text class="m-nav-title">{{id.length > 0 ? '修改委托' : '新增委托'}}</text>
			</template>
		</m-navigation-bar>
		<!-- #ifdef APP -->
		<scroll-view :scroll-y="true" style="flex:1;">
		<!-- #endif -->
			<view class="m-form-card">
				<!-- 流程 -->
				<view class="m-row" @tap="onPickProcess">
					<text class="m-row-label">委托流程</text>
					<view class="m-row-value" :style="{justifyContent: 'flex-end'}">
						<text :class="processName == '' ? 'm-row-placeholder' : 'm-row-text'">{{processName == '' ? '全部流程' : processName}}</text>
					</view>
					<m-icon type="right" :size="18" color="#C8C8C8"></m-icon>
				</view>
				<!-- 代理人 -->
				<view class="m-row" @tap="onPickUser">
					<text class="m-row-label">代理人</text>
					<view class="m-row-value" :style="{justifyContent: 'flex-end'}">
						<text :class="surrogateId == '' ? 'm-row-placeholder' : 'm-row-text'">{{surrogateId == '' ? '请选择代理人' : userNameOf(surrogateId)}}</text>
					</view>
					<m-icon type="right" :size="18" color="#C8C8C8"></m-icon>
				</view>
				<!-- 开始日期 -->
				<view class="m-row" @tap="openDate('start')">
					<text class="m-row-label">开始日期</text>
					<view class="m-row-value" :style="{justifyContent: 'flex-end'}">
						<text :class="startDate == '' ? 'm-row-placeholder' : 'm-row-text'">{{startDate == '' ? '请选择' : startDate}}</text>
					</view>
					<m-icon type="calendar" :size="18" color="#C8C8C8"></m-icon>
				</view>
				<!-- 结束日期 -->
				<view class="m-row" @tap="openDate('end')">
					<text class="m-row-label">结束日期</text>
					<view class="m-row-value" :style="{justifyContent: 'flex-end'}">
						<text :class="endDate == '' ? 'm-row-placeholder' : 'm-row-text'">{{endDate == '' ? '请选择' : endDate}}</text>
					</view>
					<m-icon type="calendar" :size="18" color="#C8C8C8"></m-icon>
				</view>
				<!-- 启用开关 -->
				<view class="m-row">
					<text class="m-row-label">启用</text>
					<view class="m-row-value" :style="{justifyContent: 'flex-end'}">
						<switch :checked="enabled" color="#2563EB" style="transform:scale(0.8);" @change="onEnabledChange" />
					</view>
				</view>
			</view>
			<view class="m-submit-wrap">
				<button class="m-submit-btn" type="primary" @tap="handleSave">保存</button>
			</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
		<m-picker-year-month :showDay="true" :choosableFutureTime="true"
			:value="datePickerValue" v-model:visible="datePickerVisible" @ok="onDateOk"></m-picker-year-month>
	</view>
</template>
<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	import mPickerYearMonth from '@/components/m-picker-year-month/index.uvue'
	import { processSurrogateDetail, processSurrogateSave, processSurrogateUpdate, processDefinePage } from '@/api/workflow.uts'
	import { userSelectRows } from '@/api/user.uts'
	import { $strUtil } from '@/util/str_util'

	const id = ref('')
	const processName = ref('')
	const surrogateId = ref('')
	const userNames = ref<UTSJSONObject>({} as UTSJSONObject)
	const startDate = ref('')
	const endDate = ref('')
	const enabled = ref(true)
	const datePickerVisible = ref(false)
	const datePickerValue = ref('')
	const datePickerTarget = ref('start')
	const defines = ref<UTSJSONObject[]>([])
	const users = ref<UTSJSONObject[]>([])
	const saving = ref(false)

	function dayOf(iso: string): string {
		if (iso.length == 0) {
			return ''
		}
		let t = iso.replace('T', ' ')
		const sp = t.indexOf(' ')
		return sp > 0 ? t.substring(0, sp) : t
	}

	async function loadDetail() {
		uni.showLoading({ title: '加载中', mask: true })
		try {
			const res = await processSurrogateDetail(id.value)
			const d = res as UTSJSONObject
			if ((d.getString('id') ?? '') == '') {
				uni.showToast({ title: '委托不存在', icon: 'none' })
				return
			}
			processName.value = d.getString('processName') ?? ''
			surrogateId.value = d.getString('surrogate') ?? ''
			startDate.value = dayOf(d.getString('startTime') ?? '')
			endDate.value = dayOf(d.getString('endTime') ?? '')
			enabled.value = (d.getNumber('enabled') ?? 1) == 1
		} catch (err) {
			uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
		} finally {
			uni.hideLoading()
		}
	}

	function loadUserNames() {
		const cached = uni.getStorageSync('app:user:names')
		if (cached != null) {
			const cs = cached.toString()
			if (cs.length > 0) {
				try {
					const obj = JSON.parse(cs) as UTSJSONObject
					if (obj != null) {
						userNames.value = obj!
					}
				} catch (e) { }
			}
		}
	}

	function userNameOf(id: string): string {
		const name = userNames.value.getString(id)
		if (name != null && name.length > 0) {
			return name!
		}
		return id
	}

	function loadDefines() {
		processDefinePage({
			pageNum: 1,
			pageSize: 100
		} as UTSJSONObject).then((res) => {
			const data = res as UTSJSONObject
			const rows = data.getArray('rows')
			if (rows != null) {
				for (let i = 0; i < rows.length; i++) {
					const row = rows[i] as UTSJSONObject
					if ((row.getNumber('state') ?? 0) == 1) {
						defines.value.push(row)
					}
				}
			}
		}).catch((_e) => { })
	}

	function loadUsers() {
		// 走 http 封装：token 失效同样吃静默续命/跳登录，不再裸 uni.request 绕过拦截器
		userSelectRows().then((rows) => {
			const map = {} as UTSJSONObject
			for (let i = 0; i < rows.length; i++) {
				const row = rows[i]
				users.value.push(row)
				const id = row.getString('value') ?? ''
				const label = row.getString('label') ?? ''
				if (id.length > 0 && label.length > 0) {
					map[id] = label
				}
			}
			userNames.value = map
			uni.setStorageSync('app:user:names', JSON.stringify(map))
		}).catch((_e) => { })
	}

	function onPickProcess() {
		const names: string[] = ['全部流程']
		for (let i = 0; i < defines.value.length; i++) {
			const name = defines.value[i].getString('displayName') ?? ''
			let dup = false
			for (let j = 0; j < names.length; j++) {
				if (names[j] == name) { dup = true; break }
			}
			if (!dup) {
				names.push(name)
			}
		}
		uni.showActionSheet({
			title: '选择委托流程',
			itemList: names,
			success: (res: ShowActionSheetSuccess) => {
				if (res.tapIndex != null) {
					const idx = parseInt(res.tapIndex.toString())
					processName.value = idx == 0 ? '' : names[idx]
				}
			}
		})
	}

	function onPickUser() {
		const names: string[] = []
		for (let i = 0; i < users.value.length; i++) {
			names.push(users.value[i].getString('label') ?? '')
		}
		uni.showActionSheet({
			title: '选择代理人',
			itemList: names,
			success: (res: ShowActionSheetSuccess) => {
				if (res.tapIndex != null) {
					const idx = parseInt(res.tapIndex.toString())
					if (idx >= 0 && idx < users.value.length) {
						surrogateId.value = users.value[idx].getString('value') ?? ''
					}
				}
			}
		})
	}

	function openDate(target: string) {
		datePickerTarget.value = target
		const current = target == 'start' ? startDate.value : endDate.value
		if (current.length > 0) {
			datePickerValue.value = current
		} else {
			const d = new Date()
			const m = d.getMonth() + 1
			const day = d.getDate()
			datePickerValue.value = d.getFullYear().toString() + '-' + (m <= 9 ? '0' + m : m.toString()) + '-' + (day <= 9 ? '0' + day : day.toString())
		}
		datePickerVisible.value = true
	}

	function onDateOk(e: UTSJSONObject) {
		datePickerVisible.value = false
		const year = e.getNumber('year') ?? 0
		const month = e.getNumber('month') ?? 1
		const day = e.getNumber('day') ?? 1
		const dateStr = year.toString() + '-' + (month <= 9 ? '0' + month : month.toString()) + '-' + (day <= 9 ? '0' + day : day.toString())
		if (datePickerTarget.value == 'start') {
			startDate.value = dateStr
		} else {
			endDate.value = dateStr
		}
	}

	function onEnabledChange(e: SwitchChangeEvent) {
		enabled.value = e.detail.value
	}

	async function handleSave() {
		if (saving.value) {
			return
		}
		if (surrogateId.value.length == 0) {
			uni.showToast({ title: '请选择代理人', icon: 'none' })
			return
		}
		if (startDate.value.length == 0 || endDate.value.length == 0) {
			uni.showToast({ title: '请选择委托起止日期', icon: 'none' })
			return
		}
		const param = {
			processName: processName.value,
			surrogate: surrogateId.value,
			startTime: startDate.value + ' 00:00:00',
			endTime: endDate.value + ' 23:59:59',
			enabled: enabled.value ? 1 : 0
		} as UTSJSONObject
		if (id.value.length > 0) {
			param['id'] = id.value
		}
		saving.value = true
		uni.showLoading({ title: '保存中……', mask: true })
		try {
			if (id.value.length > 0) {
				await processSurrogateUpdate(param)
			} else {
				await processSurrogateSave(param)
			}
			uni.hideLoading()
			uni.showToast({ title: '保存成功', icon: 'success' })
			setTimeout(() => {
				uni.navigateBack()
			}, 600)
		} catch (err) {
			uni.hideLoading()
			uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
		} finally {
			saving.value = false
		}
	}

	onLoad((options: OnLoadOptions) => {
		id.value = options['id'] ?? ''
		loadUserNames()
		loadDefines()
		loadUsers()
		if (id.value.length > 0) {
			loadDetail()
		}
	})
</script>
<style lang="less">
	.m-form-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		margin: 20rpx;
		padding: 10rpx 24rpx;
	}

	.m-row {
		flex-direction: row;
		align-items: center;
		height: 100rpx;
		border-bottom: 1rpx solid #F0F0F0;
	}

	.m-row-label {
		width: 170rpx;
		font-size: 28rpx;
		color: #333333;
	}

	.m-row-value {
		flex: 1;
		flex-direction: row;
		align-items: center;
		padding-right: 12rpx;
	}

	.m-row-text {
		font-size: 28rpx;
		color: #333333;
	}

	.m-row-placeholder {
		font-size: 28rpx;
		color: #BBBBBB;
	}

	.m-submit-wrap {
		padding: 20rpx 40rpx 60rpx 40rpx;
	}

	.m-submit-btn {
		background-color: #2563EB;
		border-radius: 12rpx;
	}
</style>
