<template>
	<view style="flex: 1;background-color: #F5F6FA;">
		<m-navigation-bar :showBack="true" :moreWidth="'160rpx'" :hasMore="true">
			<template #title>
				<text class="m-nav-title">消息中心</text>
			</template>
			<template #more>
				<view class="m-nav-more" @tap="onMarkAllRead">
					<text class="m-nav-action">全部已读</text>
				</view>
			</template>
		</m-navigation-bar>
		<!-- 两段式：未读 / 全部（对齐主流 App 消息模块；未读走后端 m_t_EQ_isRead=0 过滤） -->
		<view class="m-seg-row">
			<view v-for="(seg, index) in segs" :key="index" class="m-seg" :class="currentTab == index ? 'm-seg-active' : ''" @tap="onSegTap(index)">
				<text :class="currentTab == index ? 'm-seg-text-active' : 'm-seg-text'">{{seg.label}}</text>
				<view class="m-seg-badge" v-if="index == 0 && unreadCount > 0">
					<text class="m-seg-badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
				</view>
			</view>
		</view>
		<!-- #ifdef APP -->
		<scroll-view :scroll-y="true" style="flex:1;" :refresher-enabled="true" :refresher-triggered="refresherTriggered"
			@refresherrefresh="handleRefresherrefresh" @scrolltolower="loadMore">
		<!-- #endif -->
			<view class="m-msg-list" v-if="list.length > 0">
				<view class="m-msg-item" v-for="(item, index) in list" :key="index" @tap="onTapItem(item)">
					<view class="m-msg-dot" :class="isUnread(item) ? 'm-msg-dot-on' : 'm-msg-dot-off'"></view>
					<view class="m-msg-body">
						<view class="m-msg-title-row">
							<text class="m-msg-title" :class="isUnread(item) ? 'm-msg-title-unread' : ''">{{item.getString('title') ?? ''}}</text>
							<text class="m-msg-type">{{msgTypeText(item)}}</text>
						</view>
						<text class="m-msg-content">{{item.getString('content') ?? ''}}</text>
						<text class="m-msg-meta">{{item.getString('senderName') ?? '系统'}} · {{fmtTime(item.getString('createTime') ?? '')}}</text>
					</view>
					<m-icon type="right" :size="20" color="#C8C8C8"></m-icon>
				</view>
				<view class="m-list-footer" v-if="list.length >= recordCount">
					<text class="m-list-footer-text">没有更多了</text>
				</view>
			</view>
			<m-empty-data v-else :text="currentTab == 0 ? '没有未读消息' : '还没有消息'" :subText="currentTab == 0 ? '未读消息都在这里' : '审批提醒、抄送通知会出现在这里'"></m-empty-data>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</view>
</template>
<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	import { messagePage, messageSetRead, messageUnreadCount } from '@/api/message.uts'
	import { refreshTabBadges, applyMsgBadge } from '@/util/badge.uts'
	import { $strUtil } from '@/util/str_util'

	// 分段：0 未读 / 1 全部（未读走后端 m_t_EQ_isRead=0 过滤，全部不加过滤）
	const currentTab = ref<number>(0)
	const segs = ref<{ label: string }[]>([{ label: '未读' }, { label: '全部' }] as { label: string }[])
	const unreadCount = ref<number>(0)
	const pageNum = ref<number>(1)
	const pageSize = ref<number>(15)
	const recordCount = ref<number>(0)
	const list = ref<UTSJSONObject[]>([])
	const refresherTriggered = ref(false)
	const loading = ref(false)

	function fmtTime(iso: string): string {
		if (iso.length == 0) {
			return ''
		}
		let t = iso.replace('T', ' ')
		const dot = t.indexOf('.')
		if (dot > 0) {
			t = t.substring(0, dot)
		}
		return t
	}

	function msgTypeText(item: UTSJSONObject): string {
		const t = item.getNumber('msgType') ?? 0
		if (t == 10) return '待办'
		if (t == 20) return '通知'
		if (t == 30) return '预警'
		return ''
	}

	function isUnread(item: UTSJSONObject): boolean {
		return (item.getNumber('isRead') ?? 1) == 0
	}

	function requestData(): Promise<any> {
		loading.value = true
		const param: UTSJSONObject = {
			pageNum: pageNum.value,
			pageSize: pageSize.value
		} as UTSJSONObject
		if (currentTab.value == 0) {
			// 未读过滤（后端 m_[alias]_[type]_[column] 通用查询）；.set() 动态加键
			param.set('m_t_EQ_isRead', 0)
		}
		return new Promise<any>((resolve, reject) => {
			messagePage(param).then((res) => {
				const data = res as UTSJSONObject
				recordCount.value = data.getNumber('recordCount') ?? 0
				if (pageNum.value == 1) {
					list.value = [] as UTSJSONObject[]
				}
				const rows = data.getArray('rows')
				if (rows != null) {
					for (let i = 0; i < rows.length; i++) {
						list.value.push(rows[i] as UTSJSONObject)
					}
				}
				resolve(true)
			}).catch((err) => {
				uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
				reject(err)
			}).finally(() => {
				loading.value = false
			})
		})
	}

	function loadUnreadCount() {
		messageUnreadCount().then((c) => {
			if (typeof c === 'number') {
				unreadCount.value = c as number
			} else if (c != null && typeof c === 'object') {
				const n = (c as UTSJSONObject).getNumber('count')
				if (n != null) {
					unreadCount.value = n
				}
			}
		}).catch((_e) => { })
	}

	function reload(): Promise<any> {
		pageNum.value = 1
		return requestData()
	}

	function onSegTap(index: number) {
		if (currentTab.value == index) {
			return
		}
		currentTab.value = index
		reload()
	}

	function handleRefresherrefresh() {
		refresherTriggered.value = true
		reload().finally(() => {
			refresherTriggered.value = false
			loadUnreadCount()
		})
	}

	function loadMore() {
		if (loading.value || list.value.length >= recordCount.value) {
			return
		}
		pageNum.value++
		requestData()
	}

	function onTapItem(item: UTSJSONObject) {
		const id = item.getString('id') ?? ''
		if (id.length == 0) {
			return
		}
		uni.navigateTo({
			url: '/pages/message/detail?id=' + id
		})
	}

	function onMarkAllRead() {
		uni.showModal({
			title: '全部已读',
			content: '将当前未读消息全部标记为已读？',
			success: (res: ShowModalSuccess) => {
				if (res.confirm) {
					messageSetRead([] as string[]).then((_r) => {
						applyMsgBadge(0)
						unreadCount.value = 0
						loadUnreadCount()
						reload()
						uni.showToast({ title: '已全部标为已读', icon: 'none' })
					}).catch((err) => {
						uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
					})
				}
			}
		})
	}

	onShow(() => {
		// 从详情页返回：可能已标已读，重载当前分段并刷新未读数
		reload()
		loadUnreadCount()
		refreshTabBadges()
	})
</script>
<style lang="less">
.m-nav-more{
	width: 160rpx;
	height: 88rpx;
	justify-content: center;
	align-items: center;
}
.m-nav-action{
	font-size: 26rpx;
	color: #ffffff;
}
.m-seg-row{
	flex-direction: row;
	background-color: #ffffff;
	padding: 16rpx 20rpx;
}
.m-seg{
	flex: 1;
	flex-direction: row;
	height: 64rpx;
	border-radius: 32rpx;
	justify-content: center;
	align-items: center;
}
.m-seg-active{
	background-color: #2563EB;
}
.m-seg-text{
	font-size: 28rpx;
	color: #666666;
}
.m-seg-text-active{
	font-size: 28rpx;
	color: #ffffff;
	font-weight: bold;
}
.m-seg-badge{
	margin-left: 8rpx;
	background-color: #EF4444;
	border-radius: 16rpx;
	padding: 0 10rpx;
	height: 32rpx;
	justify-content: center;
	align-items: center;
}
.m-seg-badge-text{
	font-size: 20rpx;
	color: #ffffff;
}
.m-msg-list{
	padding: 16rpx 20rpx;
}
.m-msg-item{
	flex-direction: row;
	align-items: flex-start;
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx 20rpx;
	margin-bottom: 16rpx;
}
.m-msg-dot{
	width: 16rpx;
	height: 16rpx;
	border-radius: 8rpx;
	margin-top: 12rpx;
	margin-right: 16rpx;
}
.m-msg-dot-on{
	background-color: #EF4444;
}
.m-msg-dot-off{
	background-color: #E5E7EB;
}
.m-msg-body{
	flex: 1;
}
.m-msg-title-row{
	flex-direction: row;
	align-items: center;
}
.m-msg-title{
	flex: 1;
	font-size: 28rpx;
	color: #555555;
	lines: 1;
	text-overflow: ellipsis;
}
.m-msg-title-unread{
	color: #111111;
	font-weight: bold;
}
.m-msg-type{
	font-size: 20rpx;
	color: #2563EB;
	background-color: #EFF6FF;
	padding: 2rpx 10rpx;
	border-radius: 8rpx;
	margin-left: 12rpx;
}
.m-msg-content{
	margin-top: 8rpx;
	font-size: 24rpx;
	color: #888888;
	lines: 2;
	text-overflow: ellipsis;
}
.m-msg-meta{
	margin-top: 10rpx;
	font-size: 22rpx;
	color: #AAAAAA;
}
.m-list-footer{
	align-items: center;
	padding: 24rpx;
}
.m-list-footer-text{
	font-size: 22rpx;
	color: #BBBBBB;
}
</style>
