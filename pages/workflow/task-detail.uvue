<template>
	<view style="flex: 1;background-color: #F5F6FA;">
		<m-navigation-bar :showBack="true">
			<template #title>
				<text class="m-nav-title">任务详情</text>
			</template>
		</m-navigation-bar>
		<!-- #ifdef APP -->
		<scroll-view :scroll-y="true" style="flex:1;">
		<!-- #endif -->
			<!-- 流程信息 -->
			<view class="m-card">
				<view class="m-card-title">
					<text class="m-card-title-text">流程信息</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">流程名称</text>
					<text class="m-info-value">{{instanceDisplayName}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">当前节点</text>
					<text class="m-info-value">{{taskDisplayName}}</text>
				</view>
				<!-- 退回修改·重提直返：返回节点只读（由引擎钉死） -->
				<view class="m-info-row" v-if="isDirectReapply">
					<text class="m-info-label">重新提交后返回</text>
					<text class="m-info-value">{{reapplyTargetText}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">发起时间</text>
					<text class="m-info-value">{{instanceCreateTime}}</text>
				</view>
			</view>
			<!-- 业务表单（首任务节点待办=可编辑重新提交，其余只读回显；含发起附加字段回显） -->
			<view class="m-card" v-if="allFields.length > 0">
				<view class="m-card-title">
					<text class="m-card-title-text">申请内容</text>
				</view>
				<m-schema-form :fields="allFields" :formData="formData" :readonly="!canEditBusiness"></m-schema-form>
			</view>
			<!-- 无 schema 的流程：降级展示 formData 键值 -->
			<view class="m-card" v-else-if="fallbackRows.length > 0">
				<view class="m-card-title">
					<text class="m-card-title-text">申请内容</text>
				</view>
				<view class="m-info-row" v-for="(row, index) in fallbackRows" :key="index">
					<text class="m-info-label">{{row.getString('label') ?? ''}}</text>
					<text class="m-info-value">{{row.getString('value') ?? ''}}</text>
				</view>
			</view>
			<!-- 征询未收齐：办理动作整排置灰，这里把「为什么点不动＋收到几张」讲明白（issues/247）。
			     唯一恢复出口＝撤回动态会签（未答成员行清场、已交意见保留） -->
			<view class="m-card" v-if="executable && countersignWaiting">
				<text class="m-countersign-warn">动态会签意见未收齐（已提交 {{csSubmitted}}/{{csTotal}}），办理动作已置灰；如需继续办理，请先撤回动态会签。</text>
				<view class="m-countersign-revoke">
					<button class="m-btn m-btn-reject" style="margin-left: 0;" @tap="onRevokeCountersign">撤回动态会签</button>
				</view>
			</view>
			<!-- 审批选项（对齐 vben task-form 默认审批表单：审批附件 / 指定下一节点处理人 / 抄送） -->
			<view class="m-card" v-if="executable">
				<view class="m-card-title">
					<text class="m-card-title-text">审批选项</text>
				</view>
				<view class="m-opt-row">
					<text class="m-opt-label">审批附件</text>
					<view class="m-opt-upload" @tap="onChooseApprovalFile">
						<m-icon type="plusempty" :size="20" color="#2563EB"></m-icon>
						<text class="m-opt-upload-text">选择文件</text>
					</view>
				</view>
				<view class="m-opt-file" v-for="(f, fi) in approvalFileNames" :key="'af' + fi">
					<m-icon type="paperclip" :size="16" color="#16A34A"></m-icon>
					<text class="m-opt-file-name">{{f}}</text>
				</view>
				<view class="m-opt-row" v-if="showNextNodeGroup">
					<view class="m-opt-check" @tap="toggleAssign">
						<view class="m-opt-check-box" :style="checkStyle(isAssignNext)">
							<text v-if="isAssignNext" class="m-opt-check-mark">✓</text>
						</view>
						<text class="m-opt-label" style="margin-left: 12rpx;">指定下一节点处理人</text>
					</view>
				</view>
				<view class="m-opt-pick" v-if="showNextNodeGroup && isAssignNext" @tap="openPicker('next')">
					<text :class="nextNodeNames.length > 0 ? 'm-opt-pick-value' : 'm-opt-pick-placeholder'">{{nextNodeNames.length > 0 ? nextNodeNames : '请选择下一节点处理人'}}</text>
					<m-icon type="bottom" :size="18" color="#999999"></m-icon>
				</view>
				<!-- 协同办理组：节点 properties.allowAddSign＝后加签（接力）、dynamicCountersign＝动态会签（征询）。
				     两档共用 tf_addSignOperators 且引擎禁双开，故同一组控件按档切文案（「加签给下一位」/「发起动态会签」），
				     文案不与既有「加签」（并加签，会签按钮）撞名。两档都没开的节点整组隐藏。
				     与「指定下一节点处理人」互斥（规范 06 §2.7：两键同传服务端报错），第一步＝勾其一另一组整组隐藏并清值 -->
				<view class="m-opt-row" v-if="collabAllowed && !isAssignNext">
					<view class="m-opt-check" @tap="toggleAddSign">
						<view class="m-opt-check-box" :style="checkStyle(isAddSign)">
							<text v-if="isAddSign" class="m-opt-check-mark">✓</text>
						</view>
						<text class="m-opt-label" style="margin-left: 12rpx;">{{collabLabel}}</text>
					</view>
				</view>
				<view class="m-opt-pick" v-if="collabAllowed && !isAssignNext && isAddSign" @tap="openPicker('addSign')">
					<text :class="addSignNames.length > 0 ? 'm-opt-pick-value' : 'm-opt-pick-placeholder'">{{addSignNames.length > 0 ? addSignNames : collabPickPlaceholder}}</text>
					<m-icon type="bottom" :size="18" color="#999999"></m-icon>
				</view>
				<!-- 征询原因（issues/247）：引擎把它逐条盖在成员行变量上，一人一行独立出证；后加签档不收这个值 -->
				<input class="m-approve-input" v-if="allowDynamic && isAddSign && !isAssignNext"
					v-model="addSignReason" placeholder="征询原因（选填）" placeholder-class="m-form-placeholder" />
				<view class="m-opt-row">
					<view class="m-opt-check" @tap="toggleCc">
						<view class="m-opt-check-box" :style="checkStyle(isCc)">
							<text v-if="isCc" class="m-opt-check-mark">✓</text>
						</view>
						<text class="m-opt-label" style="margin-left: 12rpx;">抄送</text>
					</view>
				</view>
				<view class="m-opt-pick" v-if="isCc" @tap="openPicker('cc')">
					<text :class="ccNames.length > 0 ? 'm-opt-pick-value' : 'm-opt-pick-placeholder'">{{ccNames.length > 0 ? ccNames : '请选择抄送人'}}</text>
					<m-icon type="bottom" :size="18" color="#999999"></m-icon>
				</view>
			</view>
				<!-- 流程图（原生渲染 m-flow-native；旧 webview 方案已删，如需回退见 git 历史 components/m-flow-webview） -->
				<view class="m-card" v-if="graph != null">
					<view class="m-card-title-row">
						<text class="m-card-title-text">流程图</text>
						<text class="m-chart-legend">已走高亮 · 当前节点高亮</text>
					</view>
					<m-flow-native :graph="graph" :highLight="highLight"></m-flow-native>
				</view>
			<!-- 审批记录（并行加载：局部占位，不再整页遮罩） -->
			<view class="m-card">
				<view class="m-card-title">
					<text class="m-card-title-text">审批记录</text>
				</view>
				<view v-if="recordsLoading && records.length == 0" class="m-records-loading">
					<text class="m-records-loading-text">加载中……</text>
				</view>
				<m-timeline v-else :records="records"></m-timeline>
			</view>
			<view style="height: 40rpx;"></view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
		<!-- 通用选人弹层（指定下一节点处理人 / 抄送 / 会签加签） -->
		<m-user-picker v-model:visible="pickerVisible" :title="pickerTitle" :options="pickerOptions"
			:selected="pickerSelected" :multiple="pickerMultiple" @ok="onPickerOk"></m-user-picker>
		<!-- 底部审批操作（对齐 vben task-form：普通 vs 会签 performType===1） -->
		<view class="m-approve-bar" v-if="executable">
			<input class="m-approve-input" v-model="comment" placeholder="请输入审批意见" placeholder-class="m-form-placeholder" />
			<view class="m-approve-btns" v-if="isFirstTaskNode">
				<!-- 蒸汽模式：原 ：first-child 去边距改内联（运行时不支持伪类） -->
				<button class="m-btn m-btn-agree" style="margin-left: 0;" :disabled="countersignWaiting" @tap="onReSubmit">重新提交</button>
			</view>
				<!-- 会签：同意 / 不同意(20) / 加签 -->
				<view class="m-approve-btns" v-else-if="isCountersign">
					<button class="m-btn m-btn-more" style="margin-left: 0; color: #333333; flex: 0.7;" @tap="onAddSign">加签</button>
					<button class="m-btn m-btn-reject" :disabled="countersignWaiting" @tap="doExecute(20)">不同意</button>
					<button class="m-btn m-btn-agree" :disabled="countersignWaiting" @tap="doExecute(1)">同意</button>
				</view>
				<!-- 普通：不同意(2) / 更多(退回) / 同意 -->
				<view class="m-approve-btns" v-else>
					<!-- 「更多」自带内联深色字会把禁用态的灰化盖掉 ⇒ 置灰时连颜色一起切（其余按钮吃框架的 disabled 灰） -->
					<button class="m-btn m-btn-more" :style="countersignWaiting ? 'margin-left: 0; color: #A8A8A8; flex: 0.7;' : 'margin-left: 0; color: #333333; flex: 0.7;'" :disabled="countersignWaiting" @tap="onMoreActions">更多</button>
				<button class="m-btn m-btn-reject" :disabled="countersignWaiting" @tap="doExecute(2)">不同意</button>
				<button class="m-btn m-btn-agree" :disabled="countersignWaiting" @tap="doExecute(1)">同意</button>
			</view>
		</view>
	</view>
</template>
<script setup lang="uts">
	import mSchemaForm from '@/components/m-schema-form/m-schema-form.uvue'
	import mTimeline from '@/components/m-timeline/m-timeline.uvue'
	import mFlowNative from '@/components/m-flow-native/m-flow-native.uvue'
	import mUserPicker from '@/components/m-user-picker/index.uvue'
	import { SchemaField, resolveFormSchema, schemaFromGraph, schemaFromTableModel, hydrateSchemaFormData, isSchemaWfForm, buildInitiatorExtraFields, applyFieldPermissions, withProcessFormPrefix } from '@/util/form_schemas.uts'
	import { processTaskDetail, processTaskExecute, processTaskAddCandidate, processTaskJumpAbleTaskNameList, processTaskCandidatePage, processTaskRevokeDynamicCountersign, processInstanceDetail, processInstanceApprovalRecord, processInstanceHighLight } from '@/api/workflow.uts'
	import { schemaGetByTableName } from '@/api/schema.uts'
	import { userPage } from '@/api/user.uts'
	import { uploadFile } from '@/api/file.uts'
	import { $strUtil } from '@/util/str_util'

	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	const taskId = ref('')
	const processInstanceId = ref('')
	const taskDisplayName = ref('')
	const instanceDisplayName = ref('')
	const instanceCreateTime = ref('')
	const executable = ref(false)
	const isFirstTaskNode = ref(false)
	// 退回修改·重提直返：返回节点（编码/显示名）。有值 ⇒ 重提走 submitType=5 且不派下一节点处理人
	const reapplySourceNode = ref('')
	const reapplyNodeName = ref('')
	// 对齐 vben：performType===1 为会签
	const performType = ref<number>(0)
	const formKey = ref('')
	const schemaFields = ref<SchemaField[]>([])
	// 流程级发起附加字段（f_nextNodeOperator/f_ccActors/f_applyReason/f_attachment，按开关回显）
	const extraFields = ref<SchemaField[]>([])
	const formData = ref<UTSJSONObject>({} as UTSJSONObject)
	const fallbackRows = ref<UTSJSONObject[]>([])
	const graph = ref<UTSJSONObject | null>(null)
	const highLight = ref<UTSJSONObject | null>(null)
	const records = ref<UTSJSONObject[]>([])
	// 审批记录并行加载中：时间线局部占位，不再全屏遮罩
	const recordsLoading = ref(true)
	const users = ref<UTSJSONObject[]>([])
	const comment = ref('')
	const submitting = ref(false)
	// ── 审批选项（对齐 vben task-form 默认审批表单）──
	// 审批附件：fileInfoId 逗号串 + 回显文件名
	const approvalFileIds = ref('')
	const approvalFileNames = ref<string[]>([])
	// 指定下一节点处理人（普通节点；候选人来自 /wf/processTask/candidatePage）
	const isAssignNext = ref(false)
	const nextNodeIds = ref<string[]>([])
	// 后加签（可重复）·「加签给下一位」：勾选项 + 已选后继办理人（多选，载荷 tf_addSignOperators）
	const isAddSign = ref(false)
	const addSignIds = ref<string[]>([])
	// 动态会签（征询）发起原因（tf_addSignReason，选填；引擎逐条盖在成员行变量上）
	const addSignReason = ref('')
	// 征询状态投影：任务详情出口 data.ext.dynamicCountersign＝{active, round, total, submitted, actors}
	const hostCountersign = ref<UTSJSONObject | null>(null)
	// 当前任务所在节点编码（taskVo.taskName；回落 taskModel.name / 显示名），用于在流程 JSON 里定位节点开关
	const taskNodeName = ref('')
	// 抄送（人员来自 /sys/user/select）
	const isCc = ref(false)
	const ccIds = ref<string[]>([])
	// 下一节点候选人 {label,value}
	const candidates = ref<UTSJSONObject[]>([])
	// 选人弹层状态
	const pickerVisible = ref(false)
	const pickerTitle = ref('')
	const pickerOptions = ref<UTSJSONObject[]>([])
	const pickerSelected = ref<string[]>([])
	const pickerMultiple = ref(true)
	const pickerSource = ref('')

	const isCountersign = computed((): boolean => {
		return performType.value == 1
	})
	// 直返待办：申请待办上带引擎的 `_reapplyContext`（或门面投影 reapplyTarget）
	const isDirectReapply = computed((): boolean => {
		return reapplySourceNode.value.length > 0
	})
	// 开关值容错读取：JSON 里可能是布尔 true、也可能被某栈序列化成 1/'1'/'true'
	// （判据与 jeeflow-ui helpers.nodeAllowsAddSign 同形；缺省/其它值一律按"没开"）
	function truthyFlag(v: any | null): boolean {
		if (v == null) {
			return false
		}
		const s = v!.toString()
		return s == 'true' || s == '1'
	}

	// 节点协同开关读取：在流程 JSON 的任务节点里按节点编码定位（id / properties.name /
	// text.value 三处匹配，同 jeeflow-ui findTaskNode），读该节点 properties.<key>。
	function nodeFlag(g: UTSJSONObject | null, nodeName: string, key: string): boolean {
		if (g == null || nodeName.length == 0) {
			return false
		}
		const nodes = g!.getArray<UTSJSONObject>('nodes')
		if (nodes == null) {
			return false
		}
		for (let i = 0; i < nodes!.length; i++) {
			const n = nodes![i]
			// 节点判据与 jeeflow-ui isTaskType 同尺（'snaker:task' 与裸 'task' 两形都认）
			const ntype = n.getString('type') ?? ''
			if (ntype != 'snaker:task' && ntype != 'task') {
				continue
			}
			const props = n.getJSON('properties')
			const pname = props != null ? (props!.getString('name') ?? '') : ''
			const ntext = n.getJSON('text')
			const tval = ntext != null ? (ntext!.getString('value') ?? '') : ''
			const id = n.getString('id') ?? ''
			if (id != nodeName && pname != nodeName && tval != nodeName) {
				continue
			}
			return props != null && truthyFlag(props!.get(key))
		}
		return false
	}

	// 协同档显隐闸（规范 02 §4.3）：allowAddSign＝后加签（接力）、dynamicCountersign＝动态会签（征询）。
	// 读的是已随实例详情载到的流程 JSON（graph = processInstance/detail 的 jsonObject），
	// 不吃后端投影（不为一枚布尔给 todoList 加逐行解析）；
	// 首任务节点/直返重提/会签一律不开——前两者是发起·重提语义，会签走既有「加签」（并加签）按钮，
	// 且引擎禁配这两档。定位不到节点 ⇒ 一律按"没开"处理，界面与改动前逐字一致。
	function collabNodeOpen(key: string): boolean {
		if (isFirstTaskNode.value || isDirectReapply.value || isCountersign.value) {
			return false
		}
		return nodeFlag(graph.value, taskNodeName.value, key)
	}
	const allowAddSign = computed((): boolean => {
		return collabNodeOpen('allowAddSign')
	})
	const allowDynamic = computed((): boolean => {
		return collabNodeOpen('dynamicCountersign')
	})
	// 两档共用同一组控件（引擎在解析期就禁了双开），所以显隐只看"任一档开着"
	const collabAllowed = computed((): boolean => {
		return allowAddSign.value || allowDynamic.value
	})
	const collabLabel = computed((): string => {
		return allowDynamic.value ? '发起动态会签' : '加签给下一位'
	})
	const collabPickPlaceholder = computed((): string => {
		return allowDynamic.value ? '请选择会签人员' : '请选择加签给下一位'
	})
	// 生效中的加签选择（闸关时残留勾选一律视同未启用，提交侧据此只发一组键）
	const addSignActive = computed((): boolean => {
		return collabAllowed.value && isAddSign.value
	})
	// 「加签给下一位」为真时整组隐藏下一节点指派（互斥第一步）
	const showNextNodeGroup = computed((): boolean => {
		return !isCountersign.value && !isDirectReapply.value && !addSignActive.value
	})
	// 投影里的计数容错读取（某栈出口成串），非数一律折 0
	function csCount(v: any | null): number {
		if (v == null) {
			return 0
		}
		const n = parseFloat(v!.toString())
		return isNaN(n) ? 0 : n
	}
	// 征询中且意见没收齐：主办所有办理动作一律置灰（owner 拍"全部置灰＋撤回接口"，暂停语义不做）
	const countersignWaiting = computed((): boolean => {
		const dc = hostCountersign.value
		if (dc == null) {
			return false
		}
		if (!truthyFlag(dc!.get('active'))) {
			return false
		}
		return csCount(dc!.get('submitted')) < csCount(dc!.get('total'))
	})
	const csSubmitted = computed((): string => {
		const dc = hostCountersign.value
		return dc == null ? '0' : $strUtil.anyToStr(dc!.get('submitted'))
	})
	const csTotal = computed((): string => {
		const dc = hostCountersign.value
		return dc == null ? '0' : $strUtil.anyToStr(dc!.get('total'))
	})
	// 返回节点显示名：投影给了显示名就用；否则按流程图节点文本回填，再退节点编码
	const reapplyTargetText = computed((): string => {
		if (reapplySourceNode.value.length == 0) {
			return ''
		}
		if (reapplyNodeName.value.length > 0) {
			return reapplyNodeName.value
		}
		return resolveNodeText(reapplySourceNode.value)
	})
	// 首任务节点待办：业务表单可编辑（重新提交，对齐 vben detail.vue view=false）
	const canEditBusiness = computed((): boolean => {
		return executable.value && isFirstTaskNode.value
	})
	// 业务字段 + 发起附加字段合并渲染
	const allFields = computed((): SchemaField[] => {
		const all: SchemaField[] = []
		for (let i = 0; i < schemaFields.value.length; i++) {
			all.push(schemaFields.value[i])
		}
		for (let i = 0; i < extraFields.value.length; i++) {
			all.push(extraFields.value[i])
		}
		return all
	})
	// ISO 时间 → yyyy-MM-dd HH:mm（截断到秒）
	function fmtTime(iso: string): string {
		if (iso.length == 0) {
			return ''
		}
		// 2026-08-29T15:14:13.639+08:00 → 2026-08-29 15:14:13
		let t = iso.replace('T', ' ')
		const dot = t.indexOf('.')
		if (dot > 0) {
			t = t.substring(0, dot)
		}
		return t
	}

	// 无移动端 schema 的流程：实例 formData（f_ 去前缀双写）铺键值列表
	function buildFallbackRows(inst: UTSJSONObject): void {
		fallbackRows.value = [] as UTSJSONObject[]
		const fd = inst.getJSON('formData')
		if (fd == null) {
			return
		}
		fd!.toMap().forEach((value, key) => {
			if (key.startsWith('f_')) {
				return
			}
			fallbackRows.value.push({
				label: key,
				value: $strUtil.anyToStr(value)
			} as UTSJSONObject)
		})
	}

	// 流程图节点编码 → 节点显示名（找不到节点回落编码）
	function resolveNodeText(node: string): string {
		const g = graph.value
		if (g == null) {
			return node
		}
		const nodes = g!.getArray<UTSJSONObject>('nodes')
		if (nodes == null) {
			return node
		}
		for (let i = 0; i < nodes!.length; i++) {
			const n = nodes![i]
			const id = n.getString('id') ?? ''
			const props = n.getJSON('properties')
			const propName = props != null ? (props!.getString('name') ?? '') : ''
			if (id != node && propName != node) {
				continue
			}
			const text = n.getJSON('text')
			const tv = text != null ? (text!.getString('value') ?? '') : ''
			if (tv.length > 0) {
				return tv
			}
			const dn = props != null ? (props!.getString('displayName') ?? '') : ''
			if (dn.length > 0) {
				return dn
			}
			return node
		}
		return node
	}

	// 解析直返返回目标：① 门面只读投影 reapplyTarget ② 引擎控制键 ext._reapplyContext
	function readReapplyTarget(task: UTSJSONObject): void {
		reapplySourceNode.value = ''
		reapplyNodeName.value = ''
		const proj = task.getJSON('reapplyTarget')
		if (proj != null) {
			const pn = proj!.getString('node') ?? (proj!.getString('sourceNode') ?? '')
			if (pn.length > 0) {
				reapplySourceNode.value = pn
				reapplyNodeName.value = proj!.getString('displayName') ?? ''
				return
			}
		}
		const ext = task.getJSON('ext')
		if (ext == null) {
			return
		}
		const ctx = ext!.getJSON('_reapplyContext')
		if (ctx == null) {
			return
		}
		const mode = ctx!.getString('mode') ?? ''
		if (mode.length > 0 && mode != 'RETURN_TO_SOURCE') {
			return
		}
		const sourceNode = ctx!.getString('sourceNode') ?? ''
		if (sourceNode.length == 0) {
			return
		}
		reapplySourceNode.value = sourceNode
	}

	async function loadAll(): Promise<void> {
		if (taskId.value.length == 0) {
			return
		}
		uni.showLoading({ title: '加载中', mask: true })
		try {
			// 1. 任务详情（整页门控；返回即渲染，后续模块渐进加载）
			const res = await processTaskDetail(taskId.value)
			uni.hideLoading()
			const task = res as UTSJSONObject
			taskDisplayName.value = task.getString('displayName') ?? ''
			// 节点编码：taskVo.taskName 为准（模型节点 id），回落 taskModel.name / 显示名
			// —— 显示名也能命中（nodeAllowsAddSign 三处匹配），但优先编码，避免同名节点误判
			const tm = task.getJSON('taskModel')
			let node = task.getString('taskName') ?? ''
			if (node.length == 0) {
				node = tm != null ? (tm!.getString('name') ?? '') : ''
			}
			if (node.length == 0) {
				node = taskDisplayName.value
			}
			taskNodeName.value = node
			// 任务详情本就带流程 JSON（spec 06 · processTask/detail 的 jsonObject）：先拿来用，
			// 让 allowAddSign 显隐闸不必等实例详情；实例详情回来后仍以它为准（同一份定义快照）
			const taskGraph = task.getJSON('jsonObject')
			if (taskGraph != null) {
				graph.value = taskGraph!
			}
			processInstanceId.value = task.getString('processInstanceId') ?? ''
			executable.value = task.getBoolean('executable') == true
			formKey.value = task.getString('formKey') ?? ''
			performType.value = task.getNumber('performType') ?? 0
			const ext = task.getJSON('ext')
			if (ext != null) {
				isFirstTaskNode.value = ext!.getBoolean('isFirstTaskNode') == true
				hostCountersign.value = ext!.getJSON('dynamicCountersign')
			} else {
				hostCountersign.value = null
			}
			// 退回修改·重提直返：本待办有没有返回目标（只读）
			readReapplyTarget(task)
			// taskModel.form（节点表单 key）优先于任务 formKey
			const taskModel = task.getJSON('taskModel')
			if (taskModel != null) {
				const nodeForm = taskModel!.getString('form') ?? ''
				if (nodeForm.length > 0) {
					formKey.value = nodeForm
				}
			}
			if (processInstanceId.value.length == 0) {
				return
			}
			// 3/4. 流程图高亮 · 审批记录：与实例详情并行，独立渲染、失败不阻断
			processInstanceHighLight(processInstanceId.value).then((hl) => {
				highLight.value = hl as UTSJSONObject
			}).catch((_e) => {
				// 高亮失败：流程图降级为无高亮渲染
			})
			processInstanceApprovalRecord(processInstanceId.value).then((res3) => {
				const rows = res3 as UTSJSONObject[]
				if (rows != null) {
					records.value = rows
				}
			}).catch((_e) => {
				// 记录失败：时间线保持空态
			}).finally(() => {
				recordsLoading.value = false
			})
			// 2. 实例详情（formData + 流程名）
			const res2 = await processInstanceDetail(processInstanceId.value)
			const inst = res2 as UTSJSONObject
			instanceDisplayName.value = inst.getString('displayName') ?? ''
			instanceCreateTime.value = fmtTime(inst.getString('createTime') ?? '')
			// formData：引擎存 f_camel；动态 schema 字段为 camel，hydrate 后回显
			const fd = inst.getJSON('formData')
			if (fd != null) {
				formData.value = fd!
			}
			// 局部 graphJson 避免与上方 graph ref 同名遮蔽（原选项式里是 this.graph 与局部 graph 分居两 scope）
			const graphJson = inst.getJSON('jsonObject')
			if (graphJson != null) {
				graph.value = graphJson!
			}
			// 对齐 vben：只按 instanceUrl/formKey；SchemaWfForm → __schema__/getByTableName(name)
			if (formKey.value.length == 0 && graphJson != null) {
				formKey.value = graphJson!.getString('instanceUrl') ?? ''
			}
			const defineName = inst.getString('name') ?? (graphJson != null ? (graphJson!.getString('name') ?? '') : '')
			const formUrl = formKey.value.length > 0
				? formKey.value
				: (graphJson != null ? (graphJson!.getString('instanceUrl') ?? '') : '')
			if (isSchemaWfForm(formUrl)) {
				if (graphJson != null) {
					const embedded = schemaFromGraph(graphJson!)
					if (embedded != null) {
						schemaFields.value = embedded!
					} else if (defineName.length > 0) {
						try {
							const modelRes = await schemaGetByTableName(defineName)
							const tfields = schemaFromTableModel(modelRes as UTSJSONObject)
							if (tfields != null) {
								schemaFields.value = tfields!
							}
						} catch (_e) {
							// ignore
						}
					}
				}
				if (schemaFields.value.length == 0) {
					uni.showToast({ title: 'SchemaWfForm 元数据表单加载失败', icon: 'none' })
				}
			} else {
				const named = resolveFormSchema(formUrl)
				if (named != null) {
					schemaFields.value = named!.fields
				} else if (formUrl.length > 0) {
					uni.showToast({ title: '未注册表单组件: ' + formUrl, icon: 'none' })
				}
			}
			// 节点字段权限（对齐 vben：enableFieldPerm → taskModel.ext 的 PERMISSION_<fieldId>）
			if (graphJson != null && graphJson!.getBoolean('enableFieldPerm') == true && task.getJSON('taskModel') != null) {
				applyFieldPermissions(schemaFields.value, task.getJSON('taskModel')!.getJSON('ext'))
			}
			if (schemaFields.value.length > 0) {
				hydrateSchemaFormData(formData.value, schemaFields.value)
			} else {
				buildFallbackRows(inst)
			}
			// 流程级发起附加字段回显：有值的必显；首节点待办可编辑时全量显示
			const extras = buildInitiatorExtraFields(graphJson, schemaFields.value)
			const showExtras: SchemaField[] = []
			for (let i = 0; i < extras.length; i++) {
				const ef = extras[i]
				if (formData.value.get(ef.field) != null || (executable.value && isFirstTaskNode.value)) {
					showExtras.push(ef)
				}
			}
			extraFields.value = showExtras
		} catch (err) {
			uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
		} finally {
			uni.hideLoading()
		}
	}

	// 业务 schema 字段当前值（只取 schemaFields 声明过的字段，不把 u_*/历史 tf_ 变量带回）
	function collectBusinessFormData(): UTSJSONObject {
		const out = {} as UTSJSONObject
		for (let i = 0; i < schemaFields.value.length; i++) {
			const f = schemaFields.value[i].field
			const v = formData.value.get(f)
			if (v != null) {
				out[f] = v!
			}
		}
		return out
	}

	// 申请待办「重新提交」：直返待办 submitType=5（引擎按 _reapplyContext 回来源节点）；
	// 无直返目标仍是既有的 submitType=0（申请节点出边重提）
	function onReSubmit(): void {
		doExecute(isDirectReapply.value ? 5 : 0)
	}

	function doExecute(submitType: number, taskName: string = ''): void {
		if (submitting.value) {
			return
		}
		// 审批意见必填（对齐 vben tf_approvalComment rules=required，全部按钮生效）
		if ((comment.value ?? '').length == 0) {
			uni.showToast({ title: '请填写审批意见', icon: 'none' })
			return
		}
		// 两组互斥的最终判定（对齐 jeeflow-ui collectTf / vben5 task-form）：
		// 加签是「同意」的附属效果 ⇒ 只在同意(1)生效；不同意/退回/跳转一律不发加签键，
		// 且加签启用时不发下一节点指派键、反之亦然——隐藏不等于值消失，未启用那组的键在此处就不写进 payload。
		const addSignOn = addSignActive.value && submitType == 1
		const nextOn = showNextNodeGroup.value && isAssignNext.value
		// 指派/抄送勾选后必须选人（对齐 vben selectRequired）；直返重提不派下一节点处理人 ⇒ 不校验该项
		if (nextOn && nextNodeIds.value.length == 0) {
			uni.showToast({ title: '请选择下一节点处理人', icon: 'none' })
			return
		}
		if (addSignOn && addSignIds.value.length == 0) {
			uni.showToast({ title: allowDynamic.value ? '请选择会签人员' : '请选择加签给下一位', icon: 'none' })
			return
		}
		if (isCc.value && ccIds.value.length == 0) {
			uni.showToast({ title: '请选择抄送人', icon: 'none' })
			return
		}
		submitting.value = true
		uni.showLoading({ title: '提交中……', mask: true })
		const param = {
			processTaskId: taskId.value,
			submitType: submitType,
			tf_approvalComment: comment.value ?? ''
		} as UTSJSONObject
		// 审批附件（vben tf_approvalAttachment，fileInfoId 逗号串，引擎 FlowConst 同键）
		if (approvalFileIds.value.length > 0) {
			param['tf_approvalAttachment'] = approvalFileIds.value
		}
		// 指定下一节点处理人 / 抄送（引擎对数组与逗号串双兼容）；跳转(4)与直返重提(5)剔除指派（对齐 vben）
		if (nextOn && submitType != 4 && submitType != 5) {
			param['tf_isAssignNextNodeOperator'] = true
			param['tf_nextNodeOperator'] = nextNodeIds.value
		}
		// 协同档提交：tf_addSignOperators 数组（规范 06 §2.7），submitType 仍是原有同意(1)；
		// 与 tf_nextNodeOperator 互斥 ⇒ nextOn 为假时上一段根本不写那两个键，这里不再补删。
		// 征询档额外带 tf_addSignReason（引擎逐条盖在成员行变量上，一人一行独立出证）
		if (addSignOn) {
			param['tf_isAddSign'] = true
			param['tf_addSignOperators'] = addSignIds.value
			if (allowDynamic.value && (addSignReason.value ?? '').length > 0) {
				param['tf_addSignReason'] = addSignReason.value
			}
		}
		if (isCc.value) {
			param['tf_isCc'] = true
			param['tf_ccActors'] = ccIds.value
		}
		// 首节点重新提交(0) / 直返重提(5)：业务字段带 f_ 前缀重交 + 发起附加映射 tf_（对齐 vben detail.vue onConfirm）
		if (submitType == 0 || submitType == 5) {
			const biz = withProcessFormPrefix(collectBusinessFormData())
			biz.toMap().forEach((value, key) => {
				param[key] = value
			})
			// 直返重提：下一节点由引擎钉死，operator 覆写参数一个都不发
			// 加签启用时同样不补 tf_nextNodeOperator（重提路径的 f_ 回显是真实残留源，互斥第二步在此挡死）
			if (submitType == 0 && !addSignOn) {
				const nno = formData.value.get('f_nextNodeOperator')
				if (nno != null) {
					param['tf_nextNodeOperator'] = nno!
				}
			}
			const cca = formData.value.get('f_ccActors')
			if (cca != null) {
				param['tf_ccActors'] = cca!
			}
		}
		if (submitType == 4 && taskName.length > 0) {
			param['taskName'] = taskName
		}
		processTaskExecute(param).then((res) => {
			uni.hideLoading()
			// 征询发起的响应 marker（data.dynamicCountersign）：主办行没办结、任务还在自己待办里，
			// 所以不能按「办理成功」退页——清掉本轮勾选、重读详情，让未收齐横幅与置灰态当场生效。
			// 普通办结时封装层把 null data 折成 true（非对象），故先判形状再取，别硬转
			let marker: UTSJSONObject | null = null
			if (res != null && typeof res === 'object') {
				marker = (res as UTSJSONObject).getJSON('dynamicCountersign')
			}
			if (marker != null) {
				uni.showToast({
					title: '已发起动态会签（第 ' + $strUtil.anyToStr(marker!.get('round')) + ' 轮 · 共 '
						+ $strUtil.anyToStr(marker!.get('total')) + ' 人待答复）',
					icon: 'none'
				})
				isAddSign.value = false
				addSignIds.value = [] as string[]
				addSignReason.value = ''
				uni.setStorageSync('pages:approval:approval:refresh', true)
				loadAll()
				return
			}
			uni.showToast({ title: '办理成功', icon: 'success' })
			uni.setStorageSync('pages:approval:approval:refresh', true)
			setTimeout(() => {
				uni.navigateBack()
			}, 800)
		}).catch((err) => {
			uni.hideLoading()
			uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
		}).finally(() => {
			submitting.value = false
		})
	}

	// 撤回动态会签（征询置灰态的唯一恢复出口）：未答成员行清场、已交意见保留，不可逆 ⇒ 先二次确认
	function onRevokeCountersign(): void {
		if (submitting.value) {
			return
		}
		uni.showModal({
			title: '撤回动态会签',
			content: '撤回后未交意见的成员行会被清场（已交意见保留），确定撤回本轮动态会签吗？',
			success: (r: ShowModalSuccess) => {
				if (!r.confirm) {
					return
				}
				submitting.value = true
				uni.showLoading({ title: '撤回中……', mask: true })
				// reason 进主办行征询账本（与 vben 同值文案）
				processTaskRevokeDynamicCountersign({
					processTaskId: taskId.value,
					reason: '主办收回征询'
				} as UTSJSONObject).then((_r) => {
					uni.hideLoading()
					uni.showToast({ title: '已撤回动态会签，未交意见的成员行已清场', icon: 'none' })
					// 主办行没办结，只是闸门开了：留在本页重读详情，不能走退页那一路
					uni.setStorageSync('pages:approval:approval:refresh', true)
					loadAll()
				}).catch((err) => {
					uni.hideLoading()
					uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
				}).finally(() => {
					submitting.value = false
				})
			}
		})
	}

	// 跳转到已完成节点（submitType=4 + taskName），对齐 vben select-jumb-node
	function onJumpNode(): void {
		if (processInstanceId.value.length == 0) {
			return
		}
		uni.showLoading({ title: '加载中', mask: true })
		processTaskJumpAbleTaskNameList({
			processInstanceId: processInstanceId.value
		} as UTSJSONObject).then((res) => {
			uni.hideLoading()
			const rows = res as UTSJSONObject[]
			if (rows == null || rows.length == 0) {
				uni.showToast({ title: '暂无可跳转节点', icon: 'none' })
				return
			}
			const labels: string[] = []
			const values: string[] = []
			for (let i = 0; i < rows.length; i++) {
				labels.push(rows[i].getString('label') ?? '')
				values.push(rows[i].getString('value') ?? '')
			}
			uni.showActionSheet({
				title: '跳转到节点',
				itemList: labels,
				success: (r2: ShowActionSheetSuccess) => {
					if (r2.tapIndex == null) return
					const j = parseInt(r2.tapIndex.toString())
					if (j < 0 || j >= values.length) return
					const tn = values[j]
					if (tn.length == 0) return
					uni.showModal({
						title: '确认跳转',
						content: '将流程跳转回「' + labels[j] + '」节点重新办理？',
						success: (r3: ShowModalSuccess) => {
							if (r3.confirm) {
								doExecute(4, tn)
							}
						}
					})
				}
			})
		}).catch((err) => {
			uni.hideLoading()
			uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
		})
	}

	// id 集合 → label 逗号串（options 为候选/用户 {label,value}）
	function namesOf(options: UTSJSONObject[], ids: string[]): string {
		const names: string[] = []
		for (let i = 0; i < ids.length; i++) {
			for (let j = 0; j < options.length; j++) {
				if ((options[j].getString('value') ?? '') == ids[i]) {
					names.push(options[j].getString('label') ?? ids[i])
					break
				}
			}
		}
		return names.join('、')
	}

	const nextNodeNames = computed((): string => {
		return namesOf(candidates.value, nextNodeIds.value)
	})
	const ccNames = computed((): string => {
		return namesOf(users.value, ccIds.value)
	})
	// 加签人选显示名（数据源与下一节点指派同取 candidatePage，形状照 vben5 同位组）
	const addSignNames = computed((): string => {
		return namesOf(candidates.value, addSignIds.value)
	})

	function onMoreActions(): void {
		uni.showActionSheet({
			title: '更多操作',
			itemList: ['退回上一步', '退回发起人', '跳转到指定节点'],
			success: (res: ShowActionSheetSuccess) => {
				if (res.tapIndex == null) return
				const idx = parseInt(res.tapIndex.toString())
				if (idx == 0) {
					doExecute(3)
				} else if (idx == 1) {
					doExecute(6)
				} else if (idx == 2) {
					onJumpNode()
				}
			}
		})
	}

	function loadUsers(): void {
		// 抄送/加签数据源切 /sys/user/page（对齐 vben UserSelect 抽屉：行含 deptName 供搜索+部门名展示）
		userPage({
			pageNum: 1,
			pageSize: 200
		} as UTSJSONObject).then((res) => {
			const resObj = res as UTSJSONObject
			const rows = resObj != null ? resObj!.getArray<UTSJSONObject>('rows') : null
			users.value = [] as UTSJSONObject[]
			if (rows != null) {
				for (let i = 0; i < rows!.length; i++) {
					const id = rows![i].getString('id') ?? ''
					if (id.length == 0) {
						continue
					}
					users.value.push({
						label: rows![i].getString('realName') ?? id,
						value: id,
						desc: rows![i].getString('deptName') ?? ''
					} as UTSJSONObject)
				}
			}
			// 选人弹层已打开时补选项（用户列表异步晚于弹层）
			// 只喂抄送/会签加签两源：addSign（后加签）用 candidatePage，被这里覆盖成 /sys/user/page 会串数据源
			if (pickerVisible.value && (pickerSource.value == 'cc' || pickerSource.value == 'sign')) {
				pickerOptions.value = users.value
			}
		}).catch((_e) => { })
	}

	// ── 审批选项：附件 / 指派下一节点处理人 / 抄送 / 会签加签 ──
	function checkStyle(on: boolean): string {
		return on ? 'background-color:#2563EB;border-color:#2563EB;' : ''
	}

	function toggleAssign(): void {
		isAssignNext.value = !isAssignNext.value
		// 互斥第一步（勾其一则另一组隐藏并清空值）：隐藏不等于值消失，残留值会进 payload
		if (isAssignNext.value && (isAddSign.value || addSignIds.value.length > 0)) {
			isAddSign.value = false
			addSignIds.value = [] as string[]
		}
	}

	function toggleAddSign(): void {
		if (!collabAllowed.value) {
			// 闸关（含 graph 未到位的瞬时态）不接受勾选，避免勾上后闸再翻转把残留带进提交
			return
		}
		isAddSign.value = !isAddSign.value
		if (isAddSign.value && (isAssignNext.value || nextNodeIds.value.length > 0)) {
			isAssignNext.value = false
			nextNodeIds.value = [] as string[]
		}
	}

	function toggleCc(): void {
		isCc.value = !isCc.value
	}

	function onChooseApprovalFile(): void {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths == null || paths.length == 0) {
					return
				}
				uni.showLoading({
					title: '上传中……',
					mask: true
				})
				uploadFile(paths[0]).then((data) => {
					uni.hideLoading()
					const fileInfoId = data.getString('fileInfoId') ?? ''
					const url = data.getString('url') ?? ''
					if (fileInfoId.length > 0) {
						// 记录文件名用于回显（取 url 最后一段），契约同 m-schema-form upload
						let name = url
						const idx = url.lastIndexOf('/')
						if (idx >= 0 && idx < url.length - 1) {
							name = url.substring(idx + 1)
						}
						approvalFileIds.value = approvalFileIds.value.length > 0 ? approvalFileIds.value + ',' + fileInfoId : fileInfoId
						approvalFileNames.value.push(name)
					}
				}).catch((err) => {
					uni.hideLoading()
					uni.showToast({
						title: $strUtil.anyToStr(err),
						icon: 'none'
					})
				})
			}
		} as ChooseImageOptions)
	}

	// 下一节点候选人（candidatePage，realName/id，对齐 vben UserSelect 数据源）
	function loadCandidates(): void {
		processTaskCandidatePage({
			processTaskId: taskId.value,
			pageNum: 1,
			pageSize: 200
		} as UTSJSONObject).then((res) => {
			const resObj = res as UTSJSONObject
			const rows = resObj != null ? resObj.getArray<UTSJSONObject>('rows') : null
			const opts: UTSJSONObject[] = []
			if (rows != null) {
				for (let i = 0; i < rows!.length; i++) {
					const id = rows![i].getString('id') ?? ''
					if (id.length == 0) {
						continue
					}
					opts.push({ label: rows![i].getString('realName') ?? id, value: id } as UTSJSONObject)
				}
			}
			candidates.value = opts
			// 下一节点指派与后加签同取 candidatePage：候选异步晚于弹层到位时两边都要补上
			if (pickerVisible.value && (pickerSource.value == 'next' || pickerSource.value == 'addSign')) {
				pickerOptions.value = candidates.value
			}
		}).catch((_e) => {
			// 候选接口异常：选项留空，弹层内提示暂无可选
		})
	}

	function openPicker(source: string): void {
		pickerSource.value = source
		if (source == 'next') {
			if (candidates.value.length == 0) {
				loadCandidates()
			}
			pickerTitle.value = '选择下一节点处理人'
			pickerOptions.value = candidates.value
			pickerSelected.value = nextNodeIds.value
			pickerMultiple.value = true
		} else if (source == 'cc') {
			if (users.value.length == 0) {
				loadUsers()
			}
			pickerTitle.value = '选择抄送人'
			pickerOptions.value = users.value
			pickerSelected.value = ccIds.value
			pickerMultiple.value = true
		} else if (source == 'addSign') {
			// 协同档选人：数据源沿用 candidatePage（与 vben5 / jeeflow-ui 同位组一致），多选
			if (candidates.value.length == 0) {
				loadCandidates()
			}
			pickerTitle.value = allowDynamic.value ? '选择会签人员' : '加签给下一位'
			pickerOptions.value = candidates.value
			pickerSelected.value = addSignIds.value
			pickerMultiple.value = true
		} else {
			// 会签加签：多选（对齐 vben select-user ApiSelect multiple）
			if (users.value.length == 0) {
				loadUsers()
			}
			pickerTitle.value = '加签给'
			pickerOptions.value = users.value
			pickerSelected.value = [] as string[]
			pickerMultiple.value = true
		}
		pickerVisible.value = true
	}

	function onPickerOk(vals: string[]): void {
		if (pickerSource.value == 'next') {
			nextNodeIds.value = vals
		} else if (pickerSource.value == 'addSign') {
			addSignIds.value = vals
		} else if (pickerSource.value == 'cc') {
			ccIds.value = vals
		} else if (pickerSource.value == 'sign') {
			if (vals.length == 0) {
				return
			}
			if (submitting.value) {
				return
			}
			// 加签直接提交（引擎 toStringList 数组/逗号串双兼容）
			submitting.value = true
			uni.showLoading({ title: '加签中……', mask: true })
			processTaskAddCandidate({
				processTaskId: taskId.value,
				processInstanceId: processInstanceId.value,
				actorIds: vals
			} as UTSJSONObject).then((_r) => {
				uni.hideLoading()
				uni.showToast({ title: '加签成功', icon: 'success' })
			}).catch((err) => {
				uni.hideLoading()
				uni.showToast({ title: $strUtil.anyToStr(err), icon: 'none' })
			}).finally(() => {
				submitting.value = false
			})
		}
	}

	function onAddSign(): void {
		if (users.value.length == 0) {
			uni.showToast({ title: '用户列表加载中，请稍后', icon: 'none' })
			loadUsers()
			return
		}
		openPicker('sign')
	}

	onLoad((options: OnLoadOptions) => {
		taskId.value = options['taskId'] ?? ''
		loadAll()
		loadUsers()
	})
</script>
<style lang="less">
	// 蒸汽模式压平：仅简单 class 选择器；首按钮去边距 / check 内 label 边距 / 更多按钮深色字均改模板内联 style
	.m-records-loading {
		padding: 24rpx 0;
		align-items: center;
	}

	.m-countersign-warn {
		font-size: 26rpx;
		color: #B45309;
		line-height: 38rpx;
	}

	.m-countersign-revoke {
		margin-top: 16rpx;
	}

	.m-records-loading-text {
		font-size: 24rpx;
		color: #BBBBBB;
	}

	.m-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		margin: 20rpx;
		padding: 24rpx;
	}

	// 两个标题语境（.m-card-title / .m-card-title-row）原属性完全一致，合并为单类
	.m-card-title {
		margin-bottom: 12rpx;
	}

	.m-card-title-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12rpx;
	}

	.m-card-title-text {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
	}

	.m-chart-legend {
		font-size: 22rpx;
		color: #BBBBBB;
	}

	.m-info-row {
		flex-direction: row;
		justify-content: space-between;
		padding: 14rpx 0;
	}

	.m-info-label {
		font-size: 26rpx;
		color: #999999;
	}

	.m-info-value {
		font-size: 26rpx;
		color: #333333;
		max-width: 460rpx;
		text-align: right;
	}

	.m-form-placeholder {
		font-size: 26rpx;
		color: #BBBBBB;
	}

	.m-approve-bar {
		background-color: #ffffff;
		padding: 20rpx 24rpx;
	}

	.m-approve-input {
		height: 72rpx;
		background-color: #F5F6FA;
		border-radius: 12rpx;
		padding: 0 24rpx;
		font-size: 26rpx;
	}

	.m-approve-btns {
		flex-direction: row;
		margin-top: 20rpx;
	}

	.m-btn {
		flex: 1;
		font-size: 28rpx;
		border-radius: 12rpx;
		color: #ffffff;
		margin-left: 12rpx;
	}

	.m-btn-agree {
		background-color: #2563EB;
	}

	.m-btn-reject {
		background-color: #EF4444;
	}

	// 深色字由模板内联覆盖（与 .m-btn 的 color 白字冲突，不依赖规则顺序）
	.m-btn-more {
		background-color: #F5F6FA;
	}

	/* 审批选项（附件 / 指派 / 抄送）——顶层类 */
	.m-opt-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 16rpx 0;
	}

	.m-opt-label {
		font-size: 26rpx;
		color: #333333;
	}

	.m-opt-upload {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 180rpx;
		height: 60rpx;
		border: 1rpx dashed #2563EB;
		border-radius: 8rpx;
	}

	.m-opt-upload-text {
		margin-left: 8rpx;
		font-size: 24rpx;
		color: #2563EB;
	}

	.m-opt-file {
		flex-direction: row;
		align-items: center;
		padding: 8rpx 0;
	}

	.m-opt-file-name {
		margin-left: 8rpx;
		font-size: 24rpx;
		color: #666666;
	}

	.m-opt-check {
		flex: 1;
		flex-direction: row;
		align-items: center;
	}

	.m-opt-check-box {
		width: 34rpx;
		height: 34rpx;
		border: 2rpx solid #CCCCCC;
		border-radius: 6rpx;
		justify-content: center;
		align-items: center;
	}

	.m-opt-check-mark {
		color: #ffffff;
		font-size: 22rpx;
	}

	.m-opt-pick {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		padding: 8rpx 0 16rpx 46rpx;
	}

	.m-opt-pick-value {
		font-size: 26rpx;
		color: #333333;
		flex: 1;
		margin-right: 12rpx;
		text-align: right;
		lines: 2;
	}

	.m-opt-pick-placeholder {
		font-size: 26rpx;
		color: #BBBBBB;
		flex: 1;
		margin-right: 12rpx;
		text-align: right;
	}
</style>
