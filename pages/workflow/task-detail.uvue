<template>
	<view style="flex: 1;background-color: #F5F6FA;">
		<m-navigation-bar :showBack="true">
			<template #title>
				<text class="m-nav-title">任务详情</text>
			</template>
		</m-navigation-bar>
		<!-- #ifdef APP -->
		<scroll-view style="flex:1;">
		<!-- #endif -->
			<!-- 流程信息 -->
			<view class="m-card">
				<view class="m-card-title">
					<text class="m-card-title-text">流程信息</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">流程名称</text>
					<text class="m-info-value">{{instanceDisplayName}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">当前节点</text>
					<text class="m-info-value">{{taskDisplayName}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">发起时间</text>
					<text class="m-info-value">{{instanceCreateTime}}</text>
				</view>
			</view>
			<!-- 业务表单（首任务节点待办=可编辑重新提交，其余只读回显；含发起附加字段回显） -->
			<view class="m-card" v-if="allFields.length > 0">
				<view class="m-card-title">
					<text class="m-card-title-text">申请内容</text>
				</view>
				<m-schema-form :fields="allFields" :formData="formData" :readonly="!canEditBusiness"></m-schema-form>
			</view>
			<!-- 无 schema 的流程：降级展示 formData 键值 -->
			<view class="m-card" v-else-if="fallbackRows.length > 0">
				<view class="m-card-title">
					<text class="m-card-title-text">申请内容</text>
				</view>
				<view class="m-info-row" v-for="(row, index) in fallbackRows" :key="index">
					<text class="m-info-label">{{row.getString('label') ?? ''}}</text>
					<text class="m-info-value">{{row.getString('value') ?? ''}}</text>
				</view>
			</view>
			<!-- 审批选项（对齐 vben task-form 默认审批表单：审批附件 / 指定下一节点处理人 / 抄送） -->
			<view class="m-card" v-if="executable">
				<view class="m-card-title">
					<text class="m-card-title-text">审批选项</text>
				</view>
				<view class="m-opt-row">
					<text class="m-opt-label">审批附件</text>
					<view class="m-opt-upload" @tap="onChooseApprovalFile">
						<m-icon type="plusempty" :size="20" color="#2563EB"></m-icon>
						<text class="m-opt-upload-text">选择文件</text>
					</view>
				</view>
				<view class="m-opt-file" v-for="(f, fi) in approvalFileNames" :key="'af' + fi">
					<m-icon type="paperclip" :size="16" color="#16A34A"></m-icon>
					<text class="m-opt-file-name">{{f}}</text>
				</view>
				<view class="m-opt-row" v-if="!isCountersign">
					<view class="m-opt-check" @tap="toggleAssign">
						<view class="m-opt-check-box" :style="checkStyle(isAssignNext)">
							<text v-if="isAssignNext" class="m-opt-check-mark">✓</text>
						</view>
						<text class="m-opt-label">指定下一节点处理人</text>
					</view>
				</view>
				<view class="m-opt-pick" v-if="isAssignNext && !isCountersign" @tap="openPicker('next')">
					<text :class="nextNodeNames.length > 0 ? 'm-opt-pick-value' : 'm-opt-pick-placeholder'">{{nextNodeNames.length > 0 ? nextNodeNames : '请选择下一节点处理人'}}</text>
					<m-icon type="bottom" :size="18" color="#999999"></m-icon>
				</view>
				<view class="m-opt-row">
					<view class="m-opt-check" @tap="toggleCc">
						<view class="m-opt-check-box" :style="checkStyle(isCc)">
							<text v-if="isCc" class="m-opt-check-mark">✓</text>
						</view>
						<text class="m-opt-label">抄送</text>
					</view>
				</view>
				<view class="m-opt-pick" v-if="isCc" @tap="openPicker('cc')">
					<text :class="ccNames.length > 0 ? 'm-opt-pick-value' : 'm-opt-pick-placeholder'">{{ccNames.length > 0 ? ccNames : '请选择抄送人'}}</text>
					<m-icon type="bottom" :size="18" color="#999999"></m-icon>
				</view>
			</view>
				<!-- 流程图（原生渲染 m-flow-native；旧 webview 方案已删，如需回退见 git 历史 components/m-flow-webview） -->
				<view class="m-card" v-if="graph != null">
					<view class="m-card-title-row">
						<text class="m-card-title-text">流程图</text>
						<text class="m-chart-legend">已走高亮 · 当前节点高亮</text>
					</view>
					<m-flow-native :graph="graph" :highLight="highLight"></m-flow-native>
				</view>
			<!-- 审批记录（并行加载：局部占位，不再整页遮罩） -->
			<view class="m-card">
				<view class="m-card-title">
					<text class="m-card-title-text">审批记录</text>
				</view>
				<view v-if="recordsLoading && records.length == 0" class="m-records-loading">
					<text class="m-records-loading-text">加载中……</text>
				</view>
				<m-timeline v-else :records="records"></m-timeline>
			</view>
			<view style="height: 40rpx;"></view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
		<!-- 通用选人弹层（指定下一节点处理人 / 抄送 / 会签加签） -->
		<m-user-picker v-model:visible="pickerVisible" :title="pickerTitle" :options="pickerOptions"
			:selected="pickerSelected" :multiple="pickerMultiple" @ok="onPickerOk"></m-user-picker>
		<!-- 底部审批操作（对齐 vben task-form：普通 vs 会签 performType===1） -->
		<view class="m-approve-bar" v-if="executable">
			<input class="m-approve-input" v-model="comment" placeholder="请输入审批意见" placeholder-class="m-form-placeholder" />
			<view class="m-approve-btns" v-if="isFirstTaskNode">
				<button class="m-btn m-btn-agree" @tap="doExecute(0)">重新提交</button>
			</view>
			<!-- 会签：同意 / 不同意(20) / 加签 -->
			<view class="m-approve-btns" v-else-if="isCountersign">
				<button class="m-btn m-btn-more" @tap="onAddSign">加签</button>
				<button class="m-btn m-btn-reject" @tap="doExecute(20)">不同意</button>
				<button class="m-btn m-btn-agree" @tap="doExecute(1)">同意</button>
			</view>
			<!-- 普通：不同意(2) / 更多(退回) / 同意 -->
			<view class="m-approve-btns" v-else>
				<button class="m-btn m-btn-more" @tap="onMoreActions">更多</button>
				<button class="m-btn m-btn-reject" @tap="doExecute(2)">不同意</button>
				<button class="m-btn m-btn-agree" @tap="doExecute(1)">同意</button>
			</view>
		</view>
	</view>
</template>
<script lang="uts">
	import mSchemaForm from '@/components/m-schema-form/m-schema-form.uvue'
	import mTimeline from '@/components/m-timeline/m-timeline.uvue'
	import mFlowNative from '@/components/m-flow-native/m-flow-native.uvue'
	import mUserPicker from '@/components/m-user-picker/index.uvue'
	import { SchemaField, resolveFormSchema, schemaFromGraph, schemaFromTableModel, hydrateSchemaFormData, isSchemaWfForm, buildInitiatorExtraFields, applyFieldPermissions, withProcessFormPrefix } from '@/util/form_schemas.uts'
	import { processTaskDetail, processTaskExecute, processTaskAddCandidate, processTaskJumpAbleTaskNameList, processTaskCandidatePage, processInstanceDetail, processInstanceApprovalRecord, processInstanceHighLight } from '@/api/workflow.uts'
	import { schemaGetByTableName } from '@/api/schema.uts'
	import { userSelectRows } from '@/api/user.uts'
	import { uploadFile } from '@/api/file.uts'

	export default {
		components: {
			mSchemaForm,
			mTimeline,
			mFlowNative,
			mUserPicker
		},
		data() {
			return {
				taskId: '',
				processInstanceId: '',
				taskDisplayName: '',
				instanceDisplayName: '',
				instanceCreateTime: '',
				executable: false,
				isFirstTaskNode: false,
				// 对齐 vben：performType===1 为会签
				performType: 0,
				formKey: '',
				schemaFields: [] as SchemaField[],
				// 流程级发起附加字段（f_nextNodeOperator/f_ccActors/f_applyReason/f_attachment，按开关回显）
				extraFields: [] as SchemaField[],
				formData: {} as UTSJSONObject,
				fallbackRows: [] as UTSJSONObject[],
				graph: null as UTSJSONObject | null,
				highLight: null as UTSJSONObject | null,
				records: [] as UTSJSONObject[],
				// 审批记录并行加载中：时间线局部占位，不再全屏遮罩
				recordsLoading: true,
				users: [] as UTSJSONObject[],
				comment: '',
				submitting: false,
				// ── 审批选项（对齐 vben task-form 默认审批表单）──
				// 审批附件：fileInfoId 逗号串 + 回显文件名
				approvalFileIds: '',
				approvalFileNames: [] as string[],
				// 指定下一节点处理人（普通节点；候选人来自 /wf/processTask/candidatePage）
				isAssignNext: false,
				nextNodeIds: [] as string[],
				// 抄送（人员来自 /sys/user/select）
				isCc: false,
				ccIds: [] as string[],
				// 下一节点候选人 {label,value}
				candidates: [] as UTSJSONObject[],
				// 选人弹层状态
				pickerVisible: false,
				pickerTitle: '',
				pickerOptions: [] as UTSJSONObject[],
				pickerSelected: [] as string[],
				pickerMultiple: true,
				pickerSource: ''
			};
		},
		computed: {
			isCountersign: (): boolean => {
				return this.performType == 1
			},
			// 首任务节点待办：业务表单可编辑（重新提交，对齐 vben detail.vue view=false）
			canEditBusiness: (): boolean => {
				return this.executable && this.isFirstTaskNode
			},
			// 业务字段 + 发起附加字段合并渲染
			allFields: (): SchemaField[] => {
				const all: SchemaField[] = []
				for (let i = 0; i < this.schemaFields.length; i++) {
					all.push(this.schemaFields[i])
				}
				for (let i = 0; i < this.extraFields.length; i++) {
					all.push(this.extraFields[i])
				}
				return all
			},
			nextNodeNames: (): string => {
				return this.namesOf(this.candidates, this.nextNodeIds)
			},
			ccNames: (): string => {
				return this.namesOf(this.users, this.ccIds)
			}
		},
		onLoad(options: OnLoadOptions) {
			this.taskId = options['taskId'] ?? ''
			this.loadAll()
			this.loadUsers()
		},
		methods: {
			async loadAll() {
				if (this.taskId.length == 0) {
					return
				}
				uni.showLoading({ title: '加载中', mask: true })
				try {
					// 1. 任务详情（整页门控；返回即渲染，后续模块渐进加载）
					const res = await processTaskDetail(this.taskId)
					uni.hideLoading()
					const task = res as UTSJSONObject
					this.taskDisplayName = task.getString('displayName') ?? ''
					this.processInstanceId = task.getString('processInstanceId') ?? ''
					this.executable = task.getBoolean('executable') == true
					this.formKey = task.getString('formKey') ?? ''
					this.performType = task.getNumber('performType') ?? 0
					const ext = task.getJSON('ext')
					if (ext != null) {
						this.isFirstTaskNode = ext!.getBoolean('isFirstTaskNode') == true
					}
					// taskModel.form（节点表单 key）优先于任务 formKey
					const taskModel = task.getJSON('taskModel')
					if (taskModel != null) {
						const nodeForm = taskModel!.getString('form') ?? ''
						if (nodeForm.length > 0) {
							this.formKey = nodeForm
						}
					}
					if (this.processInstanceId.length == 0) {
						return
					}
					// 3/4. 流程图高亮 · 审批记录：与实例详情并行，独立渲染、失败不阻断
					processInstanceHighLight(this.processInstanceId).then((hl) => {
						this.highLight = hl as UTSJSONObject
					}).catch((_e) => {
						// 高亮失败：流程图降级为无高亮渲染
					})
					processInstanceApprovalRecord(this.processInstanceId).then((res3) => {
						const rows = res3 as UTSJSONObject[]
						if (rows != null) {
							this.records = rows
						}
					}).catch((_e) => {
						// 记录失败：时间线保持空态
					}).finally(() => {
						this.recordsLoading = false
					})
					// 2. 实例详情（formData + 流程名）
					const res2 = await processInstanceDetail(this.processInstanceId)
					const inst = res2 as UTSJSONObject
					this.instanceDisplayName = inst.getString('displayName') ?? ''
					this.instanceCreateTime = this.fmtTime(inst.getString('createTime') ?? '')
					// formData：引擎存 f_camel；动态 schema 字段为 camel，hydrate 后回显
					const fd = inst.getJSON('formData')
					if (fd != null) {
						this.formData = fd!
					}
					const graph = inst.getJSON('jsonObject')
					if (graph != null) {
						this.graph = graph!
					}
					// 对齐 vben：只按 instanceUrl/formKey；SchemaWfForm → __schema__/getByTableName(name)
					if (this.formKey.length == 0 && graph != null) {
						this.formKey = graph!.getString('instanceUrl') ?? ''
					}
					const defineName = inst.getString('name') ?? (graph != null ? (graph!.getString('name') ?? '') : '')
					const formUrl = this.formKey.length > 0
						? this.formKey
						: (graph != null ? (graph!.getString('instanceUrl') ?? '') : '')
					if (isSchemaWfForm(formUrl)) {
						if (graph != null) {
							const embedded = schemaFromGraph(graph!)
							if (embedded != null) {
								this.schemaFields = embedded!
							} else if (defineName.length > 0) {
								try {
									const modelRes = await schemaGetByTableName(defineName)
									const tfields = schemaFromTableModel(modelRes as UTSJSONObject)
									if (tfields != null) {
										this.schemaFields = tfields!
									}
								} catch (_e) {
									// ignore
								}
							}
						}
						if (this.schemaFields.length == 0) {
							uni.showToast({ title: 'SchemaWfForm 元数据表单加载失败', icon: 'none' })
						}
					} else {
						const named = resolveFormSchema(formUrl)
						if (named != null) {
							this.schemaFields = named!.fields
						} else if (formUrl.length > 0) {
							uni.showToast({ title: '未注册表单组件: ' + formUrl, icon: 'none' })
						}
					}
					// 节点字段权限（对齐 vben：enableFieldPerm → taskModel.ext 的 PERMISSION_<fieldId>）
					if (graph != null && graph!.getBoolean('enableFieldPerm') == true && task.getJSON('taskModel') != null) {
						applyFieldPermissions(this.schemaFields, task.getJSON('taskModel')!.getJSON('ext'))
					}
					if (this.schemaFields.length > 0) {
						hydrateSchemaFormData(this.formData, this.schemaFields)
					} else {
						this.buildFallbackRows(inst)
					}
					// 流程级发起附加字段回显：有值的必显；首节点待办可编辑时全量显示
					const extras = buildInitiatorExtraFields(graph, this.schemaFields)
					const showExtras: SchemaField[] = []
					for (let i = 0; i < extras.length; i++) {
						const ef = extras[i]
						if (this.formData.get(ef.field) != null || (this.executable && this.isFirstTaskNode)) {
							showExtras.push(ef)
						}
					}
					this.extraFields = showExtras
				} catch (err) {
					uni.showToast({ title: this.$strUtil.anyToStr(err), icon: 'none' })
				} finally {
					uni.hideLoading()
				}
			},
			// ISO 时间 → yyyy-MM-dd HH:mm（截断到秒）
			fmtTime(iso: string): string {
				if (iso.length == 0) {
					return ''
				}
				// 2026-08-29T15:14:13.639+08:00 → 2026-08-29 15:14:13
				let t = iso.replace('T', ' ')
				const dot = t.indexOf('.')
				if (dot > 0) {
					t = t.substring(0, dot)
				}
				return t
			},
			// 无移动端 schema 的流程：实例 formData（f_ 去前缀双写）铺键值列表
			buildFallbackRows(inst: UTSJSONObject) {
				this.fallbackRows = [] as UTSJSONObject[]
				const fd = inst.getJSON('formData')
				if (fd == null) {
					return
				}
				fd!.toMap().forEach((value, key) => {
					if (key.startsWith('f_')) {
						return
					}
					this.fallbackRows.push({
						label: key,
						value: this.$strUtil.anyToStr(value)
					} as UTSJSONObject)
				})
			},
			doExecute(submitType: number, taskName: string = '') {
				if (this.submitting) {
					return
				}
				// 审批意见必填（对齐 vben tf_approvalComment rules=required，全部按钮生效）
				if ((this.comment ?? '').length == 0) {
					uni.showToast({ title: '请填写审批意见', icon: 'none' })
					return
				}
				// 指派/抄送勾选后必须选人（对齐 vben selectRequired）
				if (this.isAssignNext && !this.isCountersign && this.nextNodeIds.length == 0) {
					uni.showToast({ title: '请选择下一节点处理人', icon: 'none' })
					return
				}
				if (this.isCc && this.ccIds.length == 0) {
					uni.showToast({ title: '请选择抄送人', icon: 'none' })
					return
				}
				this.submitting = true
				uni.showLoading({ title: '提交中……', mask: true })
				const param = {
					processTaskId: this.taskId,
					submitType: submitType,
					tf_approvalComment: this.comment ?? ''
				} as UTSJSONObject
				// 审批附件（vben tf_approvalAttachment，fileInfoId 逗号串，引擎 FlowConst 同键）
				if (this.approvalFileIds.length > 0) {
					param['tf_approvalAttachment'] = this.approvalFileIds
				}
				// 指定下一节点处理人 / 抄送（引擎对数组与逗号串双兼容）；跳转(4)剔除指派（对齐 vben）
				if (submitType != 4 && !this.isCountersign && this.isAssignNext) {
					param['tf_isAssignNextNodeOperator'] = true
					param['tf_nextNodeOperator'] = this.nextNodeIds
				}
				if (this.isCc) {
					param['tf_isCc'] = true
					param['tf_ccActors'] = this.ccIds
				}
				// 首节点重新提交：业务字段带 f_ 前缀重交 + 发起附加映射 tf_（对齐 vben detail.vue onConfirm）
				if (submitType == 0) {
					const biz = withProcessFormPrefix(this.collectBusinessFormData())
					biz.toMap().forEach((value, key) => {
						param[key] = value
					})
					const nno = this.formData.get('f_nextNodeOperator')
					if (nno != null) {
						param['tf_nextNodeOperator'] = nno!
					}
					const cca = this.formData.get('f_ccActors')
					if (cca != null) {
						param['tf_ccActors'] = cca!
					}
				}
				if (submitType == 4 && taskName.length > 0) {
					param['taskName'] = taskName
				}
				processTaskExecute(param).then((_res) => {
					uni.hideLoading()
					uni.showToast({ title: '办理成功', icon: 'success' })
					uni.setStorageSync('pages:approval:approval:refresh', true)
					setTimeout(() => {
						uni.navigateBack()
					}, 800)
				}).catch((err) => {
					uni.hideLoading()
					uni.showToast({ title: this.$strUtil.anyToStr(err), icon: 'none' })
				}).finally(() => {
					this.submitting = false
				})
			},
			// 业务 schema 字段当前值（只取 schemaFields 声明过的字段，不把 u_*/历史 tf_ 变量带回）
			collectBusinessFormData(): UTSJSONObject {
				const out = {} as UTSJSONObject
				for (let i = 0; i < this.schemaFields.length; i++) {
					const f = this.schemaFields[i].field
					const v = this.formData.get(f)
					if (v != null) {
						out[f] = v!
					}
				}
				return out
			},
			onMoreActions() {
				const self = this
				uni.showActionSheet({
					title: '更多操作',
					itemList: ['退回上一步', '退回发起人', '跳转到指定节点'],
					success: (res: ShowActionSheetSuccess) => {
						if (res.tapIndex == null) return
						const idx = parseInt(res.tapIndex.toString())
						if (idx == 0) {
							self.doExecute(3)
						} else if (idx == 1) {
							self.doExecute(6)
						} else if (idx == 2) {
							self.onJumpNode()
						}
					}
				})
			},
			// 跳转到已完成节点（submitType=4 + taskName），对齐 vben select-jumb-node
			onJumpNode() {
				const self = this
				if (self.processInstanceId.length == 0) {
					return
				}
				uni.showLoading({ title: '加载中', mask: true })
				processTaskJumpAbleTaskNameList({
					processInstanceId: self.processInstanceId
				} as UTSJSONObject).then((res) => {
					uni.hideLoading()
					const rows = res as UTSJSONObject[]
					if (rows == null || rows.length == 0) {
						uni.showToast({ title: '暂无可跳转节点', icon: 'none' })
						return
					}
					const labels: string[] = []
					const values: string[] = []
					for (let i = 0; i < rows.length; i++) {
						labels.push(rows[i].getString('label') ?? '')
						values.push(rows[i].getString('value') ?? '')
					}
					uni.showActionSheet({
						title: '跳转到节点',
						itemList: labels,
						success: (r2: ShowActionSheetSuccess) => {
							if (r2.tapIndex == null) return
							const j = parseInt(r2.tapIndex.toString())
							if (j < 0 || j >= values.length) return
							const tn = values[j]
							if (tn.length == 0) return
							uni.showModal({
								title: '确认跳转',
								content: '将流程跳转回「' + labels[j] + '」节点重新办理？',
								success: (r3: ShowModalSuccess) => {
									if (r3.confirm) {
										self.doExecute(4, tn)
									}
								}
							})
						}
					})
				}).catch((err) => {
					uni.hideLoading()
					uni.showToast({ title: self.$strUtil.anyToStr(err), icon: 'none' })
				})
			},
			loadUsers() {
				// 走 http 封装：token 失效同样吃静默续命/跳登录，不再裸 uni.request 绕过拦截器
				userSelectRows().then((rows) => {
					this.users = [] as UTSJSONObject[]
					for (let i = 0; i < rows.length; i++) {
						this.users.push(rows[i])
					}
					// 选人弹层已打开时补选项（用户列表异步晚于弹层）
					if (this.pickerVisible && this.pickerSource != 'next') {
						this.pickerOptions = this.users
					}
				}).catch((_e) => { })
			},
			// ── 审批选项：附件 / 指派下一节点处理人 / 抄送 / 会签加签 ──
			checkStyle(on: boolean): string {
				return on ? 'background-color:#2563EB;border-color:#2563EB;' : ''
			},
			toggleAssign() {
				this.isAssignNext = !this.isAssignNext
			},
			toggleCc() {
				this.isCc = !this.isCc
			},
			onChooseApprovalFile() {
				uni.chooseImage({
					count: 1,
					success: (res) => {
						const paths = res.tempFilePaths
						if (paths == null || paths.length == 0) {
							return
						}
						uni.showLoading({
							title: '上传中……',
							mask: true
						})
						uploadFile(paths[0]).then((data) => {
							uni.hideLoading()
							const fileInfoId = data.getString('fileInfoId') ?? ''
							const url = data.getString('url') ?? ''
							if (fileInfoId.length > 0) {
								// 记录文件名用于回显（取 url 最后一段），契约同 m-schema-form upload
								let name = url
								const idx = url.lastIndexOf('/')
								if (idx >= 0 && idx < url.length - 1) {
									name = url.substring(idx + 1)
								}
								this.approvalFileIds = this.approvalFileIds.length > 0 ? this.approvalFileIds + ',' + fileInfoId : fileInfoId
								this.approvalFileNames.push(name)
							}
						}).catch((err) => {
							uni.hideLoading()
							uni.showToast({
								title: this.$strUtil.anyToStr(err),
								icon: 'none'
							})
						})
					}
				} as ChooseImageOptions)
			},
			// 下一节点候选人（candidatePage，realName/id，对齐 vben UserSelect 数据源）
			loadCandidates() {
				processTaskCandidatePage({
					processTaskId: this.taskId,
					pageNum: 1,
					pageSize: 200
				} as UTSJSONObject).then((res) => {
					const resObj = res as UTSJSONObject
					const rows = resObj != null ? resObj.getArray<UTSJSONObject>('rows') : null
					const opts: UTSJSONObject[] = []
					if (rows != null) {
						for (let i = 0; i < rows!.length; i++) {
							const id = rows![i].getString('id') ?? ''
							if (id.length == 0) {
								continue
							}
							opts.push({ label: rows![i].getString('realName') ?? id, value: id } as UTSJSONObject)
						}
					}
					this.candidates = opts
					if (this.pickerVisible && this.pickerSource == 'next') {
						this.pickerOptions = this.candidates
					}
				}).catch((_e) => {
					// 候选接口异常：选项留空，弹层内提示暂无可选
				})
			},
			// id 集合 → label 逗号串（options 为候选/用户 {label,value}）
			namesOf(options: UTSJSONObject[], ids: string[]): string {
				const names: string[] = []
				for (let i = 0; i < ids.length; i++) {
					for (let j = 0; j < options.length; j++) {
						if ((options[j].getString('value') ?? '') == ids[i]) {
							names.push(options[j].getString('label') ?? ids[i])
							break
						}
					}
				}
				return names.join('、')
			},
			openPicker(source: string) {
				this.pickerSource = source
				if (source == 'next') {
					if (this.candidates.length == 0) {
						this.loadCandidates()
					}
					this.pickerTitle = '选择下一节点处理人'
					this.pickerOptions = this.candidates
					this.pickerSelected = this.nextNodeIds
					this.pickerMultiple = true
				} else if (source == 'cc') {
					if (this.users.length == 0) {
						this.loadUsers()
					}
					this.pickerTitle = '选择抄送人'
					this.pickerOptions = this.users
					this.pickerSelected = this.ccIds
					this.pickerMultiple = true
				} else {
					// 会签加签：多选（对齐 vben select-user ApiSelect multiple）
					if (this.users.length == 0) {
						this.loadUsers()
					}
					this.pickerTitle = '加签给'
					this.pickerOptions = this.users
					this.pickerSelected = [] as string[]
					this.pickerMultiple = true
				}
				this.pickerVisible = true
			},
			onPickerOk(vals: string[]) {
				if (this.pickerSource == 'next') {
					this.nextNodeIds = vals
				} else if (this.pickerSource == 'cc') {
					this.ccIds = vals
				} else if (this.pickerSource == 'sign') {
					if (vals.length == 0) {
						return
					}
					if (this.submitting) {
						return
					}
					// 加签直接提交（引擎 toStringList 数组/逗号串双兼容）
					this.submitting = true
					uni.showLoading({ title: '加签中……', mask: true })
					processTaskAddCandidate({
						processTaskId: this.taskId,
						processInstanceId: this.processInstanceId,
						actorIds: vals
					} as UTSJSONObject).then((_r) => {
						uni.hideLoading()
						uni.showToast({ title: '加签成功', icon: 'success' })
					}).catch((err) => {
						uni.hideLoading()
						uni.showToast({ title: this.$strUtil.anyToStr(err), icon: 'none' })
					}).finally(() => {
						this.submitting = false
					})
				}
			},
			onAddSign() {
				if (this.users.length == 0) {
					uni.showToast({ title: '用户列表加载中，请稍后', icon: 'none' })
					this.loadUsers()
					return
				}
				this.openPicker('sign')
			}
		}
	}
</script>
<style lang="less">
.m-records-loading{
	padding: 24rpx 0;
	align-items: center;
	.m-records-loading-text{
		font-size: 24rpx;
		color: #BBBBBB;
	}
}
.m-card{
	background-color: #ffffff;
	border-radius: 16rpx;
	margin: 20rpx;
	padding: 24rpx;
	.m-card-title{
		margin-bottom: 12rpx;
		.m-card-title-text{
			font-size: 30rpx;
			font-weight: bold;
			color: #333333;
		}
	}
	.m-card-title-row{
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12rpx;
		.m-card-title-text{
			font-size: 30rpx;
			font-weight: bold;
			color: #333333;
		}
		.m-chart-legend{
			font-size: 22rpx;
			color: #BBBBBB;
		}
	}
	.m-info-row{
		flex-direction: row;
		justify-content: space-between;
		padding: 14rpx 0;
		.m-info-label{
			font-size: 26rpx;
			color: #999999;
		}
		.m-info-value{
			font-size: 26rpx;
			color: #333333;
			max-width: 460rpx;
			text-align: right;
		}
	}
}
.m-form-placeholder{
	font-size: 26rpx;
	color: #BBBBBB;
}
.m-approve-bar{
	background-color: #ffffff;
	padding: 20rpx 24rpx;
	.m-approve-input{
		height: 72rpx;
		background-color: #F5F6FA;
		border-radius: 12rpx;
		padding: 0 24rpx;
		font-size: 26rpx;
	}
	.m-approve-btns{
		flex-direction: row;
		margin-top: 20rpx;
		.m-btn{
			flex: 1;
			font-size: 28rpx;
			border-radius: 12rpx;
			color: #ffffff;
			margin-left: 12rpx;
		}
		.m-btn:first-child{
			margin-left: 0;
		}
		.m-btn-agree{
			background-color: #2563EB;
		}
		.m-btn-reject{
			background-color: #EF4444;
		}
		.m-btn-more{
			background-color: #F5F6FA;
			color: #333333;
			flex: 0.7;
		}
	}
}
/* 审批选项（附件 / 指派 / 抄送）——顶层类，卡片在 .m-card 内，勿嵌进 .m-approve-bar
   （uni-app x 编译后按祖先上下文串匹配，嵌错层级选择器命不中） */
.m-opt-row{
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 16rpx 0;
	.m-opt-label{
		font-size: 26rpx;
		color: #333333;
	}
	.m-opt-upload{
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 180rpx;
		height: 60rpx;
		border: 1rpx dashed #2563EB;
		border-radius: 8rpx;
		.m-opt-upload-text{
			margin-left: 8rpx;
			font-size: 24rpx;
			color: #2563EB;
		}
	}
}
.m-opt-file{
	flex-direction: row;
	align-items: center;
	padding: 8rpx 0;
	.m-opt-file-name{
		margin-left: 8rpx;
		font-size: 24rpx;
		color: #666666;
	}
}
.m-opt-check{
	flex: 1;
	flex-direction: row;
	align-items: center;
	.m-opt-check-box{
		width: 34rpx;
		height: 34rpx;
		border: 2rpx solid #CCCCCC;
		border-radius: 6rpx;
		justify-content: center;
		align-items: center;
		.m-opt-check-mark{
			color: #ffffff;
			font-size: 22rpx;
		}
	}
	.m-opt-label{
		margin-left: 12rpx;
		font-size: 26rpx;
		color: #333333;
	}
}
.m-opt-pick{
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	padding: 8rpx 0 16rpx 46rpx;
	.m-opt-pick-value{
		font-size: 26rpx;
		color: #333333;
		flex: 1;
		margin-right: 12rpx;
		text-align: right;
		lines: 2;
	}
	.m-opt-pick-placeholder{
		font-size: 26rpx;
		color: #BBBBBB;
		flex: 1;
		margin-right: 12rpx;
		text-align: right;
	}
}
</style>
