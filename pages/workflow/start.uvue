<template>
	<view style="flex: 1;background-color: #F5F6FA;">
		<m-navigation-bar :showBack="true">
			<template #title>
				<text class="m-nav-title">发起流程</text>
			</template>
		</m-navigation-bar>
		<!-- #ifdef APP -->
		<scroll-view :scroll-y="true" style="flex:1;" :refresher-enabled="true" :refresher-triggered="refresherTriggered"
			@refresherrefresh="handleRefresherrefresh" @scrolltolower="loadMore">
		<!-- #endif -->
			<view class="m-define-list" v-if="defines.length > 0">
				<view class="m-define-item" v-for="(item, index) in defines" :key="index" @tap="onTapDefine(item)">
					<view class="m-define-icon">
						<m-icon type="compose" :size="26" color="#ffffff"></m-icon>
					</view>
					<view class="m-define-info">
						<text class="m-define-name">{{item.getString('displayName') ?? ''}}</text>
						<text class="m-define-meta">版本 v{{item.getNumber('version') ?? 1}} · {{item.getString('createTime') ?? ''}}</text>
					</view>
					<m-icon type="right" :size="20" color="#C8C8C8"></m-icon>
				</view>
			</view>
			<m-empty-data v-else></m-empty-data>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</view>
</template>
<script lang="uts">
	import { processDefinePage } from '@/api/workflow.uts'

	export default {
		data() {
			return {
				pageNum: 1,
				pageSize: 20,
				recordCount: 0,
				defines: [] as UTSJSONObject[],
				refresherTriggered: false,
				loading: false
			};
		},
		onLoad() {
			this.requestData()
		},
		methods: {
			handleRefresherrefresh() {
				this.refresherTriggered = true
				this.pageNum = 1
				this.requestData().finally(() => {
					this.refresherTriggered = false
				})
			},
			loadMore() {
				if (this.defines.length >= this.recordCount || this.loading) {
					return
				}
				this.pageNum++
				this.requestData()
			},
			requestData(): Promise<any> {
				this.loading = true
				return new Promise<any>((resolve, reject) => {
					uni.showLoading({ title: '加载中', mask: true })
					processDefinePage({
						pageNum: this.pageNum,
						pageSize: this.pageSize
					} as UTSJSONObject).then((res) => {
						const data = res as UTSJSONObject
						this.recordCount = data.getNumber('recordCount') ?? 0
						const rows = data.getArray('rows')
						if (this.pageNum == 1) {
							this.defines = [] as UTSJSONObject[]
						}
						if (rows != null) {
							for (let i = 0; i < rows.length; i++) {
								const row = rows[i] as UTSJSONObject
								// 只展示启用（state==1）
								if ((row.getNumber('state') ?? 0) != 1) {
									continue
								}
								// 同名流程去重，保留最高版本
								const name = row.getString('name') ?? ''
								let existIdx = -1
								for (let j = 0; j < this.defines.length; j++) {
									if ((this.defines[j].getString('name') ?? '') == name) {
										existIdx = j
										break
									}
								}
								if (existIdx >= 0) {
									const existV = this.defines[existIdx].getNumber('version') ?? 0
									if ((row.getNumber('version') ?? 0) > existV) {
										this.defines[existIdx] = row
									}
								} else {
									this.defines.push(row)
								}
							}
						}
						resolve(true)
					}).catch((err) => {
						uni.showToast({ title: this.$strUtil.anyToStr(err), icon: 'none' })
						reject(err)
					}).finally(() => {
						uni.hideLoading()
						this.loading = false
					})
				})
			},
			onTapDefine(item: UTSJSONObject) {
				const id = item.getString('id') ?? ''
				uni.navigateTo({
					url: '/pages/workflow/start-form?defineId=' + id
				})
			}
		}
	}
</script>
<style lang="less">
	.m-define-list {
		padding: 20rpx;
	}

	.m-define-item {
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 28rpx 24rpx;
		margin-bottom: 20rpx;
	}

	.m-define-icon {
		width: 80rpx;
		height: 80rpx;
		border-radius: 16rpx;
		background-color: #2563EB;
		justify-content: center;
		align-items: center;
	}

	.m-define-info {
		flex: 1;
		margin-left: 20rpx;
	}

	.m-define-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
	}

	.m-define-meta {
		margin-top: 8rpx;
		font-size: 22rpx;
		color: #999999;
	}
</style>
