<template>
	<view style="flex: 1;background-color: #F5F6FA;">
		<m-navigation-bar :showBack="true">
			<template #title>
				<text class="m-nav-title">流程详情</text>
			</template>
		</m-navigation-bar>
		<!-- #ifdef APP -->
		<scroll-view :scroll-y="true" style="flex:1;">
		<!-- #endif -->
			<!-- 流程信息 -->
			<view class="m-card">
				<view class="m-card-title-row">
					<text class="m-card-title-text">流程信息</text>
					<text class="m-state-tag" :style="{backgroundColor: stateColor}">{{stateText}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">流程名称</text>
					<text class="m-info-value">{{displayName}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">发起人</text>
					<text class="m-info-value">{{operatorName}}</text>
				</view>
				<view class="m-info-row">
					<text class="m-info-label">发起时间</text>
					<text class="m-info-value">{{fmtTime(createTime)}}</text>
				</view>
			</view>
			<!-- 申请内容 -->
			<view class="m-card" v-if="schemaFields.length > 0">
				<view class="m-card-title-row">
					<text class="m-card-title-text">申请内容</text>
				</view>
				<m-schema-form :fields="schemaFields" :formData="formData" :readonly="true"></m-schema-form>
			</view>
			<!-- 流程图（原生渲染 m-flow-native；旧 webview 方案已删，如需回退见 git 历史 components/m-flow-webview） -->
				<view class="m-card" v-if="graph != null">
					<view class="m-card-title-row">
						<text class="m-card-title-text">流程图</text>
						<text class="m-chart-legend">已走高亮 · 当前节点高亮</text>
					</view>
					<m-flow-native :graph="graph" :highLight="highLight"></m-flow-native>
				</view>
			<!-- 审批记录 -->
			<view class="m-card">
				<view class="m-card-title-row">
					<text class="m-card-title-text">审批记录</text>
				</view>
				<m-timeline :records="records"></m-timeline>
			</view>
			<view style="height: 40rpx;"></view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
		<!-- 底部操作：对齐 vben「我发起的」 -->
		<view class="m-action-bar" v-if="state == 10 || state == 30">
			<button class="m-action-btn m-action-btn--ghost" @tap="onCreateCc">抄送给</button>
			<button class="m-action-btn m-action-btn--danger" v-if="state == 10" @tap="onWithdraw">撤回</button>
			<button class="m-action-btn m-action-btn--primary" v-if="state == 30" @tap="onRestart">重新发起</button>
		</view>
		<view class="m-action-bar" v-else>
			<button class="m-action-btn m-action-btn--ghost" @tap="onCreateCc">抄送给</button>
		</view>
		<!-- 通用选人弹层（抄送给：多选 + 搜索 + 部门名） -->
		<m-user-picker v-model:visible="ccPickerVisible" title="选择抄送人" :options="users" :selected="[] as string[]"
			:multiple="true" @ok="onCcPickerOk"></m-user-picker>
	</view>
</template>
<script lang="uts">
	import mSchemaForm from '@/components/m-schema-form/m-schema-form.uvue'
	import mTimeline from '@/components/m-timeline/m-timeline.uvue'
	import mFlowNative from '@/components/m-flow-native/m-flow-native.uvue'
	import mUserPicker from '@/components/m-user-picker/index.uvue'
	import { SchemaField, resolveFormSchema, schemaFromGraph, schemaFromTableModel, hydrateSchemaFormData, isSchemaWfForm, buildInitiatorExtraFields } from '@/util/form_schemas.uts'
	import { processInstanceDetail, processInstanceHighLight, processInstanceApprovalRecord, processInstanceWithdraw, processInstanceCreateCc } from '@/api/workflow.uts'
	import { schemaGetByTableName } from '@/api/schema.uts'
	import { userPage } from '@/api/user.uts'

	export default {
		components: {
			mSchemaForm,
			mTimeline,
			mFlowNative,
			mUserPicker
		},
		data() {
			return {
				instanceId: '',
				state: 0,
				displayName: '',
				createTime: '',
				operatorName: '',
				processDefineId: '',
				schemaFields: [] as SchemaField[],
				formData: {} as UTSJSONObject,
				graph: null as UTSJSONObject | null,
				highLight: null as UTSJSONObject | null,
				records: [] as UTSJSONObject[],
				users: [] as UTSJSONObject[],
				ccPickerVisible: false,
				loading: false
			};
		},
		computed: {
			stateText(): string {
				if (this.state == 10) return '审批中'
				if (this.state == 20) return '已通过'
				if (this.state == 30) return '已撤回'
				if (this.state == 40) return '已中断'
				if (this.state == 45) return '已拒绝'
				if (this.state == 50) return '待提交'
				if (this.state == 99) return '已废弃'
				return '状态' + this.state.toString()
			},
			stateColor(): string {
				if (this.state == 10) return '#2563EB'
				if (this.state == 20) return '#16A34A'
				if (this.state == 30) return '#F59E0B'
				if (this.state == 45) return '#EF4444'
				return '#999999'
			}
		},
		onLoad(options: OnLoadOptions) {
			this.instanceId = options['instanceId'] ?? ''
			this.loadAll()
			this.loadUsers()
		},
		methods: {
			fmtTime(iso: string): string {
				if (iso.length == 0) {
					return ''
				}
				let t = iso.replace('T', ' ')
				const dot = t.indexOf('.')
				if (dot > 0) {
					t = t.substring(0, dot)
				}
				return t
			},
			/** 对齐 vben grid field=ext.u_realName；detail 常无 ext，再兜底 variable / 用户表 */
			resolveOperatorName(inst: UTSJSONObject, operatorId: string): string {
				const ext = inst.getJSON('ext')
				if (ext != null) {
					const n = ext!.getString('u_realName') ?? ''
					if (n.length > 0) {
						return n
					}
				}
				const variable = inst.getJSON('variable')
				if (variable != null) {
					const n = variable!.getString('u_realName') ?? ''
					if (n.length > 0) {
						return n
					}
				}
				if (operatorId.length > 0) {
					for (let i = 0; i < this.users.length; i++) {
						const id = this.users[i].getString('value') ?? ''
						if (id == operatorId) {
							const label = this.users[i].getString('label') ?? ''
							if (label.length > 0) {
								return label
							}
						}
					}
				}
				return operatorId
			},
			refreshOperatorNameIfNeeded() {
				// users 异步到达后，若仍是纯 id 则再解析一次
				if (this.operatorName.length == 0) {
					return
				}
				let looksLikeId = true
				for (let i = 0; i < this.operatorName.length; i++) {
					const c = this.operatorName.charAt(i)
					if (c < '0' || c > '9') {
						looksLikeId = false
						break
					}
				}
				if (!looksLikeId) {
					return
				}
				for (let i = 0; i < this.users.length; i++) {
					const id = this.users[i].getString('value') ?? ''
					if (id == this.operatorName) {
						const label = this.users[i].getString('label') ?? ''
						if (label.length > 0) {
							this.operatorName = label
						}
						break
					}
				}
			},
			loadUsers() {
				// /sys/user/page：行含 deptName/userName，选人弹层（带搜索+部门名）与发起人 id→姓名解析共用
				userPage({
					pageNum: 1,
					pageSize: 200
				} as UTSJSONObject).then((res) => {
					const resObj = res as UTSJSONObject
					const rows = resObj != null ? resObj!.getArray<UTSJSONObject>('rows') : null
					this.users = [] as UTSJSONObject[]
					if (rows != null) {
						for (let i = 0; i < rows!.length; i++) {
							const id = rows![i].getString('id') ?? ''
							if (id.length == 0) {
								continue
							}
							this.users.push({
								label: rows![i].getString('realName') ?? id,
								value: id,
								desc: rows![i].getString('deptName') ?? ''
							} as UTSJSONObject)
						}
					}
					this.refreshOperatorNameIfNeeded()
				}).catch((_e) => { })
			},
			async loadAll() {
				if (this.instanceId.length == 0 || this.loading) {
					return
				}
				this.loading = true
				uni.showLoading({ title: '加载中', mask: true })
				try {
					// 1. 实例详情（formData/jsonObject/state）
					const res = await processInstanceDetail(this.instanceId)
					const inst = res as UTSJSONObject
					this.state = inst.getNumber('state') ?? 0
					this.displayName = inst.getString('displayName') ?? ''
					this.createTime = inst.getString('createTime') ?? ''
					this.processDefineId = inst.getString('processDefineId') ?? ''
					const operatorId = inst.getString('operator') ?? ''
					// 对齐 vben 列表：发起人展示 ext.u_realName（operator 是用户 id）
					this.operatorName = this.resolveOperatorName(inst, operatorId)
					const fd = inst.getJSON('formData')
					if (fd != null) {
						this.formData = fd!
					}
					const graph = inst.getJSON('jsonObject')
					if (graph != null) {
						this.graph = graph!
						// 对齐 vben：只按 instanceUrl；SchemaWfForm → __schema__/getByTableName(name)
						const instanceUrl = graph!.getString('instanceUrl') ?? ''
						const defineName = inst.getString('name') ?? (graph!.getString('name') ?? '')
						if (isSchemaWfForm(instanceUrl)) {
							const embedded = schemaFromGraph(graph!)
							if (embedded != null) {
								this.schemaFields = embedded!
							} else if (defineName.length > 0) {
								try {
									const modelRes = await schemaGetByTableName(defineName)
									const tfields = schemaFromTableModel(modelRes as UTSJSONObject)
									if (tfields != null) {
										this.schemaFields = tfields!
									}
								} catch (_e) {
									// 元数据缺失时仅无申请内容卡，不阻断详情
								}
							}
							if (this.schemaFields.length == 0) {
								uni.showToast({ title: 'SchemaWfForm 元数据表单加载失败', icon: 'none' })
							}
						} else {
							const schema = resolveFormSchema(instanceUrl)
							if (schema != null) {
								this.schemaFields = schema!.fields
							} else if (instanceUrl.length > 0) {
								uni.showToast({ title: '未注册表单组件: ' + instanceUrl, icon: 'none' })
							}
						}
						hydrateSchemaFormData(this.formData, this.schemaFields)
						// 流程级发起附加字段回显（四开关；只显示 formData 有值的，避免空行噪音）
						const extras = buildInitiatorExtraFields(graph, this.schemaFields)
						for (let i = 0; i < extras.length; i++) {
							if (this.formData.get(extras[i].field) != null) {
								this.schemaFields.push(extras[i])
							}
						}
					}
					// 2. 高亮（整份透传，含 nodeProgress）+ 3. 审批记录
					try {
						const hl = await processInstanceHighLight(this.instanceId)
						this.highLight = hl as UTSJSONObject
					} catch (e) {
						// 高亮失败不影响时间线展示（降级）
					}
					const rec = await processInstanceApprovalRecord(this.instanceId)
					const rows = rec as UTSJSONObject[]
					if (rows != null) {
						this.records = rows
					}
				} catch (err) {
					uni.showToast({ title: this.$strUtil.anyToStr(err), icon: 'none' })
				} finally {
					uni.hideLoading()
					this.loading = false
				}
			},
			onCreateCc() {
				// 选人换 m-user-picker（多选 + 关键字搜索 + 部门名，对齐 vben「选择抄送人」弹窗）
				if (this.users.length == 0) {
					uni.showToast({ title: '用户列表加载中，请稍后', icon: 'none' })
					this.loadUsers()
					return
				}
				this.ccPickerVisible = true
			},
			onCcPickerOk(vals: string[]) {
				if (vals.length == 0) {
					return
				}
				const self = this
				uni.showLoading({ title: '抄送中……', mask: true })
				processInstanceCreateCc({
					processInstanceId: self.instanceId,
					actorIds: vals
				} as UTSJSONObject).then((_r) => {
					uni.hideLoading()
					uni.showToast({ title: '已抄送 ' + vals.length.toString() + ' 人', icon: 'success' })
				}).catch((err) => {
					uni.hideLoading()
					uni.showToast({ title: self.$strUtil.anyToStr(err), icon: 'none' })
				})
			},
			onWithdraw() {
				uni.showModal({
					title: '撤回流程',
					content: '撤回后流程作废且不可恢复，确定撤回？',
					success: (res: ShowModalSuccess) => {
						if (!res.confirm) return
						uni.showLoading({ title: '撤回中……', mask: true })
						processInstanceWithdraw(this.instanceId).then((_r) => {
							uni.hideLoading()
							uni.showToast({ title: '已撤回', icon: 'success' })
							uni.setStorageSync('pages:workflow:my-instances:refresh', true)
							uni.setStorageSync('pages:approval:approval:refresh', true)
							setTimeout(() => {
								this.loadAll()
							}, 600)
						}).catch((err) => {
							uni.hideLoading()
							uni.showToast({ title: this.$strUtil.anyToStr(err), icon: 'none' })
						})
					}
				})
			},
			onRestart() {
				if (this.processDefineId.length == 0) {
					uni.showToast({ title: '缺少流程定义', icon: 'none' })
					return
				}
				uni.setStorageSync('pages:workflow:start-form:prefill', JSON.stringify(this.formData))
				uni.navigateTo({
					url: '/pages/workflow/start-form?defineId=' + this.processDefineId
				})
			}
		}
	}
</script>
<style lang="less">
	.m-card {
		background-color: #ffffff;
		border-radius: 16rpx;
		margin: 20rpx;
		padding: 24rpx;
	}

	.m-card-title-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12rpx;
	}

	.m-card-title-text {
		font-size: 30rpx;
		font-weight: bold;
		color: #333333;
	}

	.m-chart-legend {
		font-size: 20rpx;
		color: #BBBBBB;
	}

	.m-state-tag {
		font-size: 22rpx;
		color: #ffffff;
		padding: 4rpx 16rpx;
		border-radius: 8rpx;
	}

	.m-info-row {
		flex-direction: row;
		justify-content: space-between;
		padding: 14rpx 0;
	}

	.m-info-label {
		font-size: 26rpx;
		color: #999999;
	}

	.m-info-value {
		font-size: 26rpx;
		color: #333333;
		max-width: 460rpx;
		text-align: right;
	}

	.m-action-bar {
		background-color: #ffffff;
		padding: 20rpx 24rpx;
		flex-direction: row;
	}

	.m-action-btn {
		flex: 1;
		border-radius: 12rpx;
		font-size: 28rpx;
		margin: 0 8rpx;
	}

	.m-action-btn--ghost {
		background-color: #F5F6FA;
		color: #333333;
	}

	.m-action-btn--danger {
		background-color: #EF4444;
		color: #ffffff;
	}

	.m-action-btn--primary {
		background-color: #2563EB;
		color: #ffffff;
	}
</style>
