import { TOKEY_KEY, resolveBaseUrl } from '@/util/const.uts'

/**
 * 文件上传（multipart/form-data，字段名 file）
 * 返回 {fullUrl, url, fileInfoId}（对齐 boot4 契约）
 * 注：走 uni.uploadFile 独立于 http.uts（后者只发 JSON POST）
 */
export const uploadFile = (filePath: string): Promise<UTSJSONObject> => {
	return new Promise<UTSJSONObject>((resolve, reject) => {
		const baseURL = resolveBaseUrl()
		const tokenRaw = uni.getStorageSync(TOKEY_KEY)
		let token = ''
		if (typeof tokenRaw === 'string') {
			token = tokenRaw as string
		}
		uni.uploadFile({
			url: baseURL + '/sys/fileInfo/upload',
			filePath: filePath,
			name: 'file',
			header: {
				'Authorization': 'Bearer ' + token
			} as UTSJSONObject,
			success: (res) => {
				if (res.statusCode != 200) {
					reject('上传失败(' + res.statusCode + ')')
					return
				}
				try {
					const body = JSON.parse(res.data) as UTSJSONObject
					const code = body.getNumber('code')
					if (code == 0) {
						const data = body.getJSON('data')
						if (data != null) {
							resolve(data)
							return
						}
					}
					const msg = body.getString('msg')
					reject(msg != null ? msg! : '上传失败')
				} catch (e) {
					reject('上传响应解析失败')
				}
			},
			fail: (err) => {
				reject(err.errMsg)
			}
		} as UploadFileOptions)
	})
}

