// ── processTask 流程任务域 ───────────────────────────────────────────────────
// 待办/已办分页 {pageNum,pageSize}
export const processTaskTodoList = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/todoList", param)
}
export const processTaskDoneList = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/doneList", param)
}
// 任务详情 {id} → {taskName,displayName,formKey,executable,ext.isFirstTaskNode,taskModel,jsonObject}
export const processTaskDetail = (id: string): Promise<any> => {
	return wfPost("processTask/detail", {
		id: id
	} as UTSJSONObject)
}
// 审批办理 {processTaskId, submitType, tf_approvalComment, ...}
// submitType：0 APPLY(普通重新提交) / 1 AGREE / 2 REJECT / 3 ROLLBACK / 4 JUMP(+taskName) / 5 RE_APPLY(直返重提)
//            / 6 ROLLBACK_TO_OPERATOR / 20 COUNTERSIGN_DISAGREE
// 直返待办（ext._reapplyContext）只接受 5，且不得带下一节点处理人覆写参数。
export const processTaskExecute = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/execute", param)
}
// 会签加签 {processTaskId, processInstanceId, actorIds: string[]}
export const processTaskAddCandidate = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/addCandidate", param)
}
// 已办撤回 {processTaskId}：办理人收回自己刚办结的那一手（原行保留、新行复活重办）。
// 节点开关（allowRecall）与窗口（下游整链未办结）一律由引擎判，前端不预判，报错原文即提示。
export const processTaskRecall = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/recall", param)
}
// 撤回动态会签 {processTaskId, reason?}：废弃本主办行下未答的成员行（已交意见保留），
// 是征询置灰态的唯一恢复出口
export const processTaskRevokeDynamicCountersign = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/revokeDynamicCountersign", param)
}
// 动态协办 {processTaskId, actorIds: string[], reason?, waitCompletion?}（issues/253）：
// 派生 task_type=1 协办子行（每人一行），协办行办结不驱动流程、主办行保留拍板权。
// waitCompletion 缺省 false＝主办不等协办办结即可推进；true＝等待闸（未齐时主办办理置灰）。
// 与转办（摘原人换人）/加签（追加参与人）语义不同，故独立 action；operator 由后端从登录态注入。
export const processTaskAidant = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/aidant", param)
}
// 可跳转节点列表 {processInstanceId} → [{label, value(taskName)}]（已完成、非会签节点）
export const processTaskJumpAbleTaskNameList = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/jumpAbleTaskNameList", param)
}
// 下一节点候选人分页 {processTaskId, pageNum, pageSize} → 分页 rows（id/realName/userName/deptName）
// （对齐 vben task-form tf_nextNodeOperator UserSelect 数据源）
export const processTaskCandidatePage = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processTask/candidatePage", param)
}

// ── processDesign 流程设计域 ─────────────────────────────────────────────────
// 按类型分组的可发起流程（工作台九宫格）空体 → [{type,title,items:[...]}]
