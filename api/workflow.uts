import { http, HttpConfig } from '@/util/http.uts'
import { WF_FACADE_PREFIX } from '@/util/const.uts'

/**
 * jeeflow 门面薄封装：单入口 POST /wf/{action}，仅保留 App 实际调用的 action。
 * id 类参数一律字符串（雪花 id 契约）；operator 由后端从登录态注入，前端不传。
 */

// ── 通用 ─────────────────────────────────────────────────────────────────────
export const wfPost = (action: string, param: UTSJSONObject | null): Promise<any> => {
	return http.post(WF_FACADE_PREFIX + action, {
		data: param
	} as HttpConfig)
}

// ── processDefine 流程定义域 ─────────────────────────────────────────────────
// 分页查询流程定义 {pageNum,pageSize,m_t_XXX_yyy...}
export const processDefinePage = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processDefine/page", param)
}
// 流程定义详情 {id} → {jsonObject 流程图JSON...}
export const processDefineDetail = (id: string): Promise<any> => {
	return wfPost("processDefine/detail", {
		id: id
	} as UTSJSONObject)
}
// 发起并执行第一个任务节点 {processDefineId, ...f_ 表单字段} → {processInstanceId}
export const processDefineStartAndExecute = (param: UTSJSONObject): Promise<any> => {
	return wfPost("processDefine/startAndExecute", param)
}
// 按流程定义名称取最新版 {processDefineName}
export const processDefineGetLastByName = (name: string): Promise<any> => {
	return wfPost("processDefine/getLastByName", {
		processDefineName: name
	} as UTSJSONObject)
}
