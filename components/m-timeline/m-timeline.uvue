<template>
	<view class="m-timeline">
		<view class="m-timeline-item" v-for="(item, index) in records" :key="index">
			<!-- 左侧轴 -->
			<view class="m-timeline-axis">
				<view class="m-timeline-dot" :class="(item.getNumber('taskState') == 10) ? 'm-timeline-dot-active' : 'm-timeline-dot-done'"></view>
				<view class="m-timeline-line" v-if="index < records.length - 1"></view>
			</view>
			<!-- 右侧内容 -->
			<view class="m-timeline-content">
				<view class="m-timeline-title-row">
					<text class="m-timeline-title">{{item.getString('displayName') ?? ''}}</text>
					<text class="m-timeline-state" :class="(item.getNumber('taskState') == 10) ? 'm-timeline-state-doing' : 'm-timeline-state-done'">
						{{stateText(item.getNumber('taskState'))}}
					</text>
				</view>
				<view class="m-timeline-meta-row" v-if="operatorText(item) != ''">
					<text class="m-timeline-meta">{{operatorLabel(index)}}{{operatorText(item)}}</text>
				</view>
				<view class="m-timeline-meta-row" v-if="(item.getString('finishTime') ?? '') != ''">
					<text class="m-timeline-meta">{{item.getString('finishTime') ?? ''}}</text>
				</view>
				<view class="m-timeline-comment" v-if="commentText(item) != ''">
					<text class="m-timeline-comment-text">{{commentText(item)}}</text>
				</view>
				<!-- 协同办理账本（tf_addSignHistory）：附加信息行，不占动作徽标/意见的坑（规范 06 §2.7） -->
				<view class="m-timeline-extra" v-for="(h, hi) in addSignHistory(item)" :key="'as' + hi">
					<text class="m-timeline-extra-text">{{addSignHistoryText(h)}}</text>
					<text class="m-timeline-extra-time" v-if="addSignHistoryTime(h) != ''">· {{addSignHistoryTime(h)}}</text>
				</view>
				<!-- 动态会签成员行（issues/247）：一人一行＝一条免责凭证，意见不聚合，这里只标出它是哪一轮的征询 -->
				<view class="m-timeline-extra" v-if="countersignLabel(item) != ''">
					<text class="m-timeline-extra-text">{{countersignLabel(item)}}</text>
				</view>
				<!-- 动态协办账本（tf_aidantHistory，issues/253）：落主办行，附加信息行出证，不占动作徽标/意见的坑 -->
				<view class="m-timeline-extra" v-for="(h, hi) in aidantHistory(item)" :key="'ad' + hi">
					<text class="m-timeline-extra-text">{{aidantHistoryText(h)}}</text>
					<text class="m-timeline-extra-time" v-if="aidantHistoryTime(h) != ''">· {{aidantHistoryTime(h)}}</text>
				</view>
				<!-- 被作废的协办子行本身仍出行：只补一句它是什么，不留空白项（owner 11-13 拍：不隐藏） -->
				<view class="m-timeline-extra" v-if="aidantRowText(item) != ''">
					<text class="m-timeline-extra-text">{{aidantRowText(item)}}</text>
				</view>
				<!-- 已办撤回留痕（tf_recallHistory，issues/246）：只追加在原行上，历史行不改写 -->
				<view class="m-timeline-extra" v-for="(h, hi) in recallHistory(item)" :key="'rc' + hi">
					<text class="m-timeline-extra-text">{{recallHistoryText(h)}}</text>
				</view>
			</view>
		</view>
		<view v-if="records.length == 0">
			<m-empty-data></m-empty-data>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	import { userSelectRows } from '@/api/user.uts'
	import { $strUtil } from '@/util/str_util.uts'

	type Props = {
		// approvalRecord 行：对齐 vben approval-record.vue → 操作人用 ext.u_realName
		records?: UTSJSONObject[]
	}

	const props = withDefaults(defineProps<Props>(), {
		records: (): UTSJSONObject[] => [] as UTSJSONObject[]
	})

	const userNames = ref<UTSJSONObject>({} as UTSJSONObject)
	const userNamesLoaded = ref(false)
	// 姓名表刷新后驱动模板重算 operatorText
	const nameTick = ref(0)

	// 首节点是申请人提交动作，其余是审批动作
	function operatorLabel(index: number): string {
		return index == 0 ? '申请人：' : '审批人：'
	}

	function stateText(state: number | null): string {
		if (state == null) return ''
		if (state == 10) return '审批中'
		if (state == 20) return '已同意'
		if (state == 30) return '已退回'
		if (state == 99) return '已废弃'
		return '状态' + state.toString()
	}

	// 留痕账本里的人都是用户 id（引擎逐栈都存 id）⇒ 借姓名表折成人名，取不到就原样显示 id。
	// 触达 nameTick，保证姓名表异步到位后重新渲染
	function nameOf(id: string): string {
		if (id.length == 0) {
			return ''
		}
		const _tick = nameTick.value
		const n = userNames.value.getString(id)
		return (n != null && n.length > 0) ? n! : id
	}

	// 转办末跳文案里嵌的是 actor 雪花 ID（引擎按审计真相存 id）⇒ 展示层借姓名表折成人名，
	// 解析不到原样保留 id，不吞信息（与 nameOf 同族）。UTS 不依赖 RegExp，手工扫连续数字串；
	// 雪花形如 19 位数字，日期/时间/轮次等短数字串不会命中，避免误替换。
	function replaceIdTokens(s: string): string {
		let out = ''
		let run = ''
		for (let i = 0; i < s.length; i++) {
			const ch = s.substring(i, i + 1)
			if (ch >= '0' && ch <= '9') {
				run += ch
			} else {
				out += (run.length >= 15 ? nameOf(run) : run)
				run = ''
				out += ch
			}
		}
		out += (run.length >= 15 ? nameOf(run) : run)
		return out
	}

	function commentText(item: UTSJSONObject): string {
		const variable = item.getJSON('variable')
		if (variable != null) {
			const c = variable!.getString('tf_approvalComment')
			if (c != null && c.length > 0) return replaceIdTokens(c!)
		}
		const ext = item.getJSON('ext')
		if (ext != null) {
			const c2 = ext!.getString('tf_approvalComment')
			if (c2 != null && c2.length > 0) return replaceIdTokens(c2!)
		}
		return ''
	}

	// ── 留痕账本（规范 06 §2.7）──
	// tf_addSignHistory 每项 {round,fromActor,toActors,time,operator}，动态会签同键并另带
	// reason / revoked（撤回清场那条）；tf_recallHistory 每项 {operator,time,recalledTaskId}。
	// 三者都只追加不改写，所以撤回/清场后的历史仍能逐条出证。
	// 取数位与转办留痕同族：审批记录行的变量出口是 ext（无则 variable 副本），不是任务表单切片 taskFormData。
	// 形态宽松解析（对象数组 / 某栈序列化成 JSON 字符串都收），解析失败＝不渲染这行。
	function parseHistory(vars: UTSJSONObject, key: string): UTSJSONObject[] | null {
		const raw = vars.get(key)
		if (raw == null) {
			return null
		}
		try {
			const arr = vars.getArray<UTSJSONObject>(key)
			if (arr != null) {
				return arr!
			}
		} catch (e) {
			// 非对象数组：落到字符串解析
		}
		const s = raw!.toString()
		if (!s.startsWith('[')) {
			return null
		}
		try {
			const wrapped = JSON.parse('{"h":' + s + '}') as UTSJSONObject
			return wrapped!.getArray<UTSJSONObject>('h')
		} catch (e2) {
			return null
		}
	}

	// 逐栈双出口取同一个键（ext 优先、variable 兜底）
	function historyOf(item: UTSJSONObject, key: string): UTSJSONObject[] {
		const none: UTSJSONObject[] = []
		let list: UTSJSONObject[] | null = null
		const ext = item.getJSON('ext')
		if (ext != null) {
			list = parseHistory(ext!, key)
		}
		if (list == null) {
			const variable = item.getJSON('variable')
			if (variable != null) {
				list = parseHistory(variable!, key)
			}
		}
		if (list == null) {
			return none
		}
		return list!
	}

	function addSignHistory(item: UTSJSONObject): UTSJSONObject[] {
		return historyOf(item, 'tf_addSignHistory')
	}

	// 动态协办账本（issues/253）：每项 {round,fromActor,toActors,reason,time,operator}，落主办行变量
	function aidantHistory(item: UTSJSONObject): UTSJSONObject[] {
		return historyOf(item, 'tf_aidantHistory')
	}

	function recallHistory(item: UTSJSONObject): UTSJSONObject[] {
		return historyOf(item, 'tf_recallHistory')
	}

	// 「已于 {time} 由 {operator} 撤回重办」（与 vben 同位文案逐字一致）
	function recallHistoryText(h: UTSJSONObject): string {
		const op = nameOf($strUtil.toStr(h.getString('operator')))
		return '已于 ' + $strUtil.toStr(h.getString('time')) + ' 由 ' + (op.length > 0 ? op : '-') + ' 撤回重办'
	}

	// 成员行判定（与 vben approval-record 同判据）：轮次戳 addSignRound_{node} 主办行也带，
	// 只有成员行才带发起原因戳 tf_addSignReason ⇒ 两枚都得有才算成员，只认轮次会把主办行自己吞进来
	function countersignReason(item: UTSJSONObject): string {
		const ext = item.getJSON('ext')
		if (ext != null) {
			const r = $strUtil.toStr(ext!.getString('tf_addSignReason'))
			if (r.length > 0) {
				return r
			}
		}
		const variable = item.getJSON('variable')
		if (variable != null) {
			return $strUtil.toStr(variable!.getString('tf_addSignReason'))
		}
		return ''
	}

	function countersignRound(item: UTSJSONObject): string {
		if (countersignReason(item).length == 0) {
			return ''
		}
		const ext = item.getJSON('ext')
		if (ext == null) {
			return ''
		}
		let round = ''
		ext!.toMap().forEach((value, key) => {
			if (!key.startsWith('addSignRound_')) {
				return
			}
			const v = $strUtil.anyToStr(value)
			if (v.length > 0 && round.length == 0) {
				round = v
			}
		})
		return round
	}

	// 一行文案：「第 N 轮征询意见 · 征询原因：X」；非成员行返回空串，模板据此不渲染
	function countersignLabel(item: UTSJSONObject): string {
		const round = countersignRound(item)
		if (round.length == 0) {
			return ''
		}
		const reason = countersignReason(item)
		return '第 ' + round + ' 轮征询意见' + (reason.length > 0 ? ' · 征询原因：' + reason : '')
	}

	// 人名列表串：['a','b'] / "a,b" / Kotlin 的 "[a, b]" 一律读成「a、b」
	function targetsText(v: any | null): string {
		if (v == null) {
			return ''
		}
		let s = v!.toString()
		if (s.startsWith('[') && s.endsWith(']')) {
			s = s.substring(1, s.length - 1)
		}
		const parts = s.split(',')
		const names: string[] = []
		for (let i = 0; i < parts.length; i++) {
			const p = parts[i].trim()
			if (p.length > 0) {
				names.push(nameOf(p))
			}
		}
		return names.join('、')
	}

	// 一行文案：「第 N 轮加签给 X、Y」（与 submitTypeLabel 同族写死，无字典服务）；
	// 动态会签的撤回清场那条带 revoked=true，动作相反，不能读成"又拉了一轮人"
	function addSignHistoryText(h: UTSJSONObject): string {
		const round = $strUtil.anyToStr(h.get('round'))
		const heads = round.length > 0 ? ('第' + round + '轮') : '加签'
		const to = targetsText(h.get('toActors'))
		const revoked = $strUtil.anyToStr(h.get('revoked'))
		if (revoked == 'true' || revoked == '1') {
			return heads + '撤回征询，摘除' + (to.length > 0 ? to : '-')
		}
		return heads + '加签给' + (to.length > 0 ? to : '-')
	}

	function addSignHistoryTime(h: UTSJSONObject): string {
		return $strUtil.toStr(h.getString('time'))
	}

	// 协办账本一行文案：「第 N 轮协办给 X、Y」（与 vben wf.instance.aidantHistory / jeeflow-ui 同位文案一致）。
	// 协办不是审批意见 ⇒ 不占 commentText 那一行，只在附加信息行出证
	function aidantHistoryText(h: UTSJSONObject): string {
		const round = $strUtil.anyToStr(h.get('round'))
		const heads = round.length > 0 ? ('第' + round + '轮') : '协办'
		// 清场那条（abandoned:true）动作与派生相反，同形渲染会读成"主办协办了两次"（与 vben aidantLine 同判据）
		const abandoned = $strUtil.anyToStr(h.get('abandoned'))
		if (abandoned == 'true' || abandoned == '1') {
			return heads + '协办已作废（离开节点时未办结）'
		}
		const to = targetsText(h.get('toActors'))
		return heads + '协办给' + (to.length > 0 ? to : '-')
	}

	// 协办子行随主办离开节点被作废（taskType=1 且 taskState=99）：引擎不给这类行投 u_realName／submitType，
	// 只剩节点名一行。owner 拍定保留该行不隐藏，补一句实话（三前端同位文案逐字一致）
	function aidantRowText(item: UTSJSONObject): string {
		const tt = $strUtil.anyToStr(item.get('taskType'))
		const st = $strUtil.anyToStr(item.get('taskState'))
		if (tt == '1' && st == '99') {
			return '协办（未办结，离开节点时已作废）'
		}
		return ''
	}

	function aidantHistoryTime(h: UTSJSONObject): string {
		return $strUtil.toStr(h.getString('time'))
	}

	function operatorText(item: UTSJSONObject): string {
		// 触达 nameTick，保证姓名表异步到位后重新渲染
		const _tick = nameTick.value
		// 1) 对齐 vben：ext.u_realName
		const ext = item.getJSON('ext')
		if (ext != null) {
			const rn = ext!.getString('u_realName') ?? ''
			if (rn.length > 0) return rn
		}
		const variable = item.getJSON('variable')
		if (variable != null) {
			const rn2 = variable!.getString('u_realName') ?? ''
			if (rn2.length > 0) return rn2
		}
		// 2) operator id → /sys/user/select 姓名表
		const op = item.getString('operator') ?? ''
		if (op.length == 0) return ''
		const name = userNames.value.getString(op)
		if (name != null && name.length > 0) return name!
		return op
	}

	// operator id → 姓名（/sys/user/select 免权限下拉，storage 缓存）
	function loadUserNames() {
		const cached = uni.getStorageSync('app:user:names')
		if (cached != null) {
			try {
				const obj = JSON.parse(cached.toString()) as UTSJSONObject
				if (obj != null) {
					userNames.value = obj!
					nameTick.value = nameTick.value + 1
				}
			} catch (e) {
				// 忽略缓存解析失败
			}
		}
		if (userNamesLoaded.value) {
			return
		}
		// 走 http 封装：token 失效同样吃静默续命/跳登录，不再裸 uni.request 绕过拦截器
		userSelectRows().then((rows) => {
			const map = {} as UTSJSONObject
			for (let i = 0; i < rows.length; i++) {
				const row = rows[i]
				const v = row.getString('value')
				const l = row.getString('label')
				if (v != null && l != null) {
					map[v!] = l!
				}
			}
			userNames.value = map
			userNamesLoaded.value = true
			nameTick.value = nameTick.value + 1
			uni.setStorageSync('app:user:names', JSON.stringify(map))
		}).catch((_err) => {
			// 静默失败：已办节点仍可读 ext.u_realName
		})
	}

	// mounted（组件挂载即拉姓名表；组合式下 setup 体直接调用，时序等效）
	loadUserNames()
</script>

<style lang="less">
	.m-timeline {
		padding: 10rpx 0 10rpx 10rpx;
	}

	.m-timeline-item {
		flex-direction: row;
	}

	.m-timeline-axis {
		width: 40rpx;
		align-items: center;
	}

	.m-timeline-dot {
		width: 20rpx;
		height: 20rpx;
		border-radius: 10rpx;
		margin-top: 12rpx;
	}

	.m-timeline-dot-done {
		background-color: #2563EB;
	}

	.m-timeline-dot-active {
		background-color: #F59E0B;
	}

	.m-timeline-line {
		width: 2rpx;
		flex: 1;
		background-color: #E0E0E0;
	}

	.m-timeline-content {
		flex: 1;
		padding-bottom: 32rpx;
		padding-left: 16rpx;
	}

	.m-timeline-title-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.m-timeline-title {
		font-size: 28rpx;
		font-weight: bold;
		color: #333333;
	}

	.m-timeline-state {
		font-size: 22rpx;
	}

	.m-timeline-state-done {
		color: #16A34A;
	}

	.m-timeline-state-doing {
		color: #F59E0B;
	}

	.m-timeline-meta-row {
		margin-top: 8rpx;
	}

	.m-timeline-meta {
		font-size: 24rpx;
		color: #999999;
	}

	.m-timeline-comment {
		margin-top: 12rpx;
		background-color: #F5F6FA;
		border-radius: 8rpx;
		padding: 16rpx;
	}

	.m-timeline-comment-text {
		font-size: 26rpx;
		color: #555555;
	}

	.m-timeline-extra {
		flex-direction: row;
		align-items: center;
		margin-top: 8rpx;
	}

	.m-timeline-extra-text {
		font-size: 24rpx;
		color: #2563EB;
	}

	.m-timeline-extra-time {
		font-size: 22rpx;
		color: #999999;
		margin-left: 10rpx;
	}
</style>
