<template>
	<view class="m-status-bar">
	    <!-- 这里是状态栏 -->
		<view class="m-status-bar-inner"></view>
	</view>
	<view class="m-app-bar"> 
		<view class="m-back-icon" v-if="showBack" @tap="handleBack">
			<slot name="icon">
				<m-icon :type="icon" :size="32"></m-icon>
			</slot>
		</view>
		<view :class="titleClass">
			<view :class="titleContentClass">
				<slot name="title">
					<text>{{title}}</text>
				</slot>
			</view>
		</view>
		<view class="m-more" v-if="hasMore" @tap="onMore" :style="{width: moreWidth}">
			<slot name="more">

			</slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	// 注意：蒸汽运行时 slots 对象没有 has() 方法（TypeError: slots.has is not a function），
	// 「是否传了 more 插槽」改为显式 hasMore prop（调用方 message.uvue/surrogate.uvue 传 :hasMore="true"）
	type Props = {
		title?: string,
		icon?: string,
		align?: string,
		showBack?: boolean,
		// 返回前处理，如果返回Promise.resolve(false),则不执行返回
		beforeBack?: () => Promise<Boolean>,
		moreWidth?: string,
		// 是否传入 more 插槽（右上角动作区，蒸汽下无法运行时探测插槽）
		hasMore?: boolean
	}

	const props = withDefaults(defineProps<Props>(), {
		title: '',
		icon: 'left',
		align: 'center',
		showBack: true,
		moreWidth: '64rpx',
		hasMore: false
	})

	const emit = defineEmits(['back', 'more'])

	const titleClass = computed((): String => {
		if (props.showBack) {
			return 'm-title center'
		}
		return 'm-title'
	})

	const titleContentClass = computed((): String => {
		let n = 0;
		if (props.showBack) {
			n++;
		}
		if (props.hasMore) {
			n++;
		}
		const w = 750 - n * 64;
		if (props.align == 'left') {
			if (props.showBack) {
				return `justify-content-flex-start align-items-flex-center row w-${w} h-88 ml-64`
			} else {
				return `justify-content-flex-start align-items-flex-center row w-${w} h-88`
			}
		} else if (props.align == 'right') {
			return `justify-content-flex-end align-items-flex-center row w-${w} h-88`
		}
		return `center row w-${w} h-88`
	})

	function handleBack() {
		if (props.beforeBack != null) {
			props.beforeBack!().then((res => {
				if (res) {
					uni.navigateBack()
				}
				emit('back')
			}))
		} else {
			uni.navigateBack()
			emit('back')
		}

	}
	function onMore() {
		emit('more')
	}
</script>

<style lang="less">
	// 样式隔离 2.0：组件不再自动继承全局工具类。本组件模板/script 动态类绑定了
	// center/row/h-88/ml-64/justify-content-* /align-items-flex-center 等（标题居中全靠它们，
	// 漏 import 的实弹后果：工作台等页面标题左对齐且溢出——v0.2.0 回归，v0.2.1 修复）
	@import url("@/static/css/common.less");

	.m-status-bar {
		height: var(--status-bar-height);
		width: 100%;
		background-color: #2563EB;
	}

	.m-status-bar-inner {
		flex: 1;
		background-color: black;
		opacity: 0.2;
	}

	.m-app-bar {
		height: 88rpx;
		background-color: #2563EB;
		flex-direction: row;
	}

	.m-back-icon {
		width: 64rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
		position: absolute;
		z-index: 999;
		left: 0rpx;
	}

	.m-title {
		flex: 1;
		flex-direction: row;
		height: 88rpx;
		align-items: center;
	}

	.m-more {
		width: 64rpx;
		height: 88rpx;
		align-items: center;
		justify-content: center;
		position: absolute;
		right: 0rpx;
		z-index: 999;
	}
</style>