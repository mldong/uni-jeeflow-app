<template>
	<view class="m-bar-list">
		<view class="m-bar-list-title" v-if="title.length > 0">
			<text class="m-bar-list-title-text">{{title}}</text>
			<text class="m-bar-list-unit" v-if="unit.length > 0">单位：{{unit}}</text>
		</view>
		<view v-if="rows.length == 0" class="m-bar-list-empty">
			<text class="m-bar-list-empty-text">暂无数据</text>
		</view>
		<view v-else class="m-bar-list-rows">
			<view class="m-bar-list-row" v-for="(item, index) in rows" :key="index">
				<text class="m-bar-list-label" :style="{color: index < 3 ? '#333333' : '#666666'}">{{item.getString('label') ?? ''}}</text>
				<view class="m-bar-list-track">
					<view class="m-bar-list-fill" :style="{
						width: barWidth(item) + '%',
						backgroundColor: barColor(index)
					}"></view>
				</view>
				<view class="m-bar-list-val-wrap">
					<text class="m-bar-list-count">{{item.getNumber('count') ?? 0}}</text>
					<text class="m-bar-list-sub" v-if="showSub(item)">{{subText(item)}}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		name: 'm-bar-list',
		props: {
			rows: {
				type: Array as PropType<UTSJSONObject[]>,
				default: (): UTSJSONObject[] => [] as UTSJSONObject[]
			},
			title: {
				type: String,
				default: ''
			},
			unit: {
				type: String,
				default: ''
			}
		},
		computed: {
			maxVal(): number {
				let m = 0
				const arr = this.rows
				for (let i = 0; i < arr.length; i++) {
					const v = arr[i].getNumber('count') ?? 0
					if (v > m) {
						m = v
					}
				}
				return m
			}
		},
		methods: {
			barWidth(item: UTSJSONObject): number {
				const max = this.maxVal
				if (max <= 0) {
					return 0
				}
				const v = item.getNumber('count') ?? 0
				const pct = Math.round(v * 100 / max)
				return pct < 2 && v > 0 ? 2 : pct
			},
			barColor(index: number): string {
				if (index == 0) return '#1D4ED8'
				if (index == 1) return '#2563EB'
				if (index == 2) return '#3B82F6'
				return '#93C5FD'
			},
			showSub(item: UTSJSONObject): boolean {
				const avg = item.getNumber('avgDurationSeconds')
				return avg != null && avg > 0
			},
			subText(item: UTSJSONObject): string {
				const avg = item.getNumber('avgDurationSeconds') ?? 0
				const days = avg / 86400.0
				const s = days.toFixed(1)
				return '均' + s + '天'
			}
		}
	}
</script>

<style lang="less">
.m-bar-list{
	.m-bar-list-title{
		flex-direction: row;
		align-items: center;
		margin-bottom: 16rpx;
		.m-bar-list-title-text{
			font-size: 28rpx;
			font-weight: bold;
			color: #333333;
		}
		.m-bar-list-unit{
			margin-left: 12rpx;
			font-size: 20rpx;
			color: #999999;
		}
	}
	.m-bar-list-empty{
		padding: 24rpx 0;
		align-items: center;
		.m-bar-list-empty-text{
			font-size: 24rpx;
			color: #BBBBBB;
		}
	}
	.m-bar-list-rows{
		.m-bar-list-row{
			flex-direction: row;
			align-items: center;
			margin-bottom: 16rpx;
			.m-bar-list-label{
				width: 160rpx;
				font-size: 24rpx;
				lines: 1;
				text-overflow: ellipsis;
			}
			.m-bar-list-track{
				flex: 1;
				height: 20rpx;
				background-color: #F0F2F5;
				border-radius: 10rpx;
				margin: 0 16rpx;
				.m-bar-list-fill{
					height: 20rpx;
					border-radius: 10rpx;
				}
			}
			.m-bar-list-val-wrap{
				width: 120rpx;
				flex-direction: row;
				align-items: flex-end;
				justify-content: flex-end;
				.m-bar-list-count{
					font-size: 26rpx;
					font-weight: bold;
					color: #333333;
				}
				.m-bar-list-sub{
					margin-left: 6rpx;
					font-size: 18rpx;
					color: #999999;
				}
			}
		}
	}
}
</style>
