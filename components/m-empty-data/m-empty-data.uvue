<template>
	<view class="center mt-20">
		<text class="m-empty-text">{{text}}</text>
		<text class="m-empty-sub" v-if="subText != ''">{{subText}}</text>
	</view>
</template>

<script>
	export default {
		name:"m-empty-data",
		props: {
			// 主文案，默认「暂无数据」保持旧行为
