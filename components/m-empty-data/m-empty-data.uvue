				type: String,
				default: '暂无数据'
			},
			// 可选引导副文案（如消息中心的「审批与抄送通知会出现在这里」）
			subText: {
				type: String,
				default: ''
			}
		},
		data() {
			return {

			};
		}
	}
</script>

