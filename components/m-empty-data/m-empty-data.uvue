<template>
	<view class="center mt-20">
		<text class="m-empty-text">{{text}}</text>
		<text class="m-empty-sub" v-if="subText != ''">{{subText}}</text>
	</view>
</template>

<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（蒸汽仅支持组合式 API）
	type Props = {
		// 主文案，默认「暂无数据」保持旧行为
		text?: string,
		// 可选引导副文案（如消息中心的「审批与抄送通知会出现在这里」）
		subText?: string
	}

	const props = withDefaults(defineProps<Props>(), {
		text: '暂无数据',
		subText: ''
	})
</script>

<style lang="less">
	// 样式隔离 2.0：组件不再自动继承全局工具类，自行导入（编译期展开，无运行时开销）
	@import url("@/static/css/common.less");

.m-empty-text{
	font-size: 28rpx;
	color: #999999;
}
.m-empty-sub{
	margin-top: 12rpx;
	font-size: 24rpx;
	color: #BBBBBB;
}
</style>