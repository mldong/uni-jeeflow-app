<script setup lang="uts">
	// 蒸汽模式迁移：选项式 → 组合式（App 级生命周期宏：onLaunch/onAppShow/onAppHide/onLastPageBackPress/onExit，
	// 写法对齐官方 hello-uni-app-x App.uvue setup 示例）
	import { IS_LOGIN_KEY, IS_DEV } from '@/util/const.uts'
	import { cleanupDownloadedApk, checkAppUpdate } from '@/util/update.uts'
	// #ifdef APP
	import { showApiSwitchSheet } from '@/util/api_switch.uts'
	// #endif

	let firstBackTime = 0
	// #ifdef APP
	// 摇一摇弹接口切换（开发环境；算法同官方 hello-uni-app-x shake 示例：合加速度瞬时变化 + 冷却防抖）
	let shakeLastMagnitude : number | null = null
	let shakeLastTime = 0
	const shakeListener : OnAccelerometerChangeCallback = (res : OnAccelerometerChangeCallbackResult) => {
		const magnitude = Math.sqrt(res.x * res.x + res.y * res.y + res.z * res.z)
		if (shakeLastMagnitude == null) {
			shakeLastMagnitude = magnitude
			return
		}
		const delta = Math.abs(magnitude - (shakeLastMagnitude as number))
		shakeLastMagnitude = magnitude
		// 诊断日志：只在幅值有变化时打（蓝叠虚拟加速度计恒定 9.81/0.23/1.71 且晃动按钮不驱动它，
		// 静止时打了也是刷屏；真机摇一摇灵敏度按这里的 delta 调阈值 1.35）
		if (delta > 0.5) {
			console.log('[shake] delta=' + delta.toFixed(3) + ' mag=' + magnitude.toFixed(3))
		}
		const now = Date.now()
		if (delta > 1.35 && now - shakeLastTime > 1200) {
			shakeLastTime = now
			showApiSwitchSheet()
		}
	}
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		// 检查更新：先清上次残留的安装包（installApk 无完成回调，只能留到下次启动清），
		// 再延后一拍静默检查（避开首帧渲染与 onAppShow 登录守卫的 reLaunch）
		cleanupDownloadedApk()
		setTimeout(() => {
			checkAppUpdate(false)
		}, 1500)
		// #ifdef APP
		// 开发环境全局摇一摇弹接口切换（模拟器无真实摇晃，走登录页长按 logo；production 编译期 IS_DEV=false 不注册）
		if (IS_DEV) {
			uni.startAccelerometer({
				interval: 'game',
				success: () => {
					console.log('[shake] startAccelerometer ok')
				},
				fail: (err) => {
					console.log('[shake] startAccelerometer fail: ' + (err.errMsg != null ? err.errMsg : ''))
				}
			})
			uni.onAccelerometerChange(shakeListener)
		}
		// #endif
	})

	onAppShow(() => {
		console.log('App Show')
		// 登录守卫：未登录一律回登录页
		const isLogin = uni.getStorageSync(IS_LOGIN_KEY)
		if(isLogin != true) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
		}
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})
	// #endif

	onExit(() => {
		console.log('App Exit')
	})
</script>

<style lang="less">
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
	@import url("@/static/css/common.less");
</style>
